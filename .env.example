ANTHROPIC_API_KEY=            # leave empty to force --replay mode
SDLC_DATABASE_URL=sqlite+aiosqlite:///./runs/sdlc.db   # or postgresql+asyncpg://sdlc:sdlc@localhost:5432/sdlc
SDLC_WORKSPACE=./workspace/url-shortener
SDLC_TARGET_STACK=java        # java | python  (selects gate commands in policy.yaml)
SDLC_MODEL=claude-opus-5       # see AnthropicClient.PRICES for known models
SDLC_LLM=auto                 # auto | fake | replay | anthropic  (fake = canned agents, no network)
