+# CI for url-shortener (T8, AC-15).
+#
+# Mirrors the governed build gates one-to-one; every step is a plain Maven wrapper
+# invocation so the same commands work locally. Nothing here needs credentials or
+# repository secrets. The integration tests provision PostgreSQL and Redis with
+# Testcontainers on the runner's Docker daemon, and the OpenAPI dump is taken from that
+# same throw-away application.
+name: ci
+
+on:
+  push:
+    branches: ["**"]
+  pull_request:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ci-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  MAVEN_OPTS: -Dmaven.repo.local=${{ github.workspace }}/.m2/repository
+
+jobs:
+  build:
+    name: gates
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 25
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: "25"
+
+      - name: Cache Maven repository
+        uses: actions/cache@v4
+        with:
+          path: .m2/repository
+          key: maven-${{ runner.os }}-${{ hashFiles('pom.xml', '.mvn/wrapper/maven-wrapper.properties') }}
+          restore-keys: |
+            maven-${{ runner.os }}-
+
+      - name: Make the wrapper executable
+        run: chmod +x mvnw
+
+      # Gate: compile (required)
+      - name: Compile
+        run: ./mvnw -q -B -DskipTests compile
+
+      # Gate: style (advisory) - reported but never fails the build.
+      - name: Style (spotless, advisory)
+        continue-on-error: true
+        run: ./mvnw -q -B spotless:check
+
+      # Gate: architecture (required) - orchestrator-provisioned layering contract.
+      - name: Architecture rules
+        run: ./mvnw -q -B -Dtest=ArchitectureTest test
+
+      # Gate: unit (required) - *Test classes only; container-free.
+      - name: Unit tests
+        run: ./mvnw -q -B test
+
+      # Gate: integration + contract (required) - *IT classes against Testcontainers
+      # PostgreSQL/Redis, plus the springdoc dump written to target/openapi.{json,yaml}.
+      - name: Integration tests and OpenAPI dump
+        run: ./mvnw -q -B -Pit verify
+
+      # Gate: contract (required) - the committed document must equal what the running
+      # application exposes. OpenApiContractIT already compares operations and status
+      # codes; both documents are kept as build artefacts for review.
+      - name: Publish OpenAPI documents
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: openapi
+          if-no-files-found: ignore
+          path: |
+            src/main/resources/openapi.yaml
+            target/openapi.yaml
+            target/openapi.json
+
+      - name: Publish test reports
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: test-reports
+          if-no-files-found: ignore
+          path: |
+            target/surefire-reports/
+            target/failsafe-reports/
+
+  docker:
+    name: docker image
+    needs: build
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      # Gate: release - the multi-stage Dockerfile must build from a clean checkout.
+      # The image is only built, never pushed; publishing is a deployment concern.
+      - name: Build image
+        run: docker build --pull -t url-shortener:${{ github.sha }} .
+
+      - name: Image runs as a non-root user
+        run: |
+          user="$(docker run --rm --entrypoint sh url-shortener:${{ github.sha }} -c 'id -un')"
+          echo "container user: ${user}"
+          test "${user}" != "root"
