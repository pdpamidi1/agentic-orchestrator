+package com.example.shortener;
+
+import com.example.shortener.config.ShortenerProperties;
+import org.springframework.boot.SpringApplication;
+import org.springframework.boot.autoconfigure.SpringBootApplication;
+import org.springframework.boot.context.properties.EnableConfigurationProperties;
+
+/**
+ * Spring Boot 4 entry point of the URL shortener.
+ *
+ * <p>Holds no business logic. The read and write surfaces live in one artifact and are selected
+ * with the {@code read} / {@code write} Spring profiles (ADR-007); with no profile active both are
+ * served.
+ */
+@SpringBootApplication
+@EnableConfigurationProperties(ShortenerProperties.class)
+public class UrlShortenerApplication {
+
+  public static void main(String[] args) {
+    SpringApplication.run(UrlShortenerApplication.class, args);
+  }
+}
