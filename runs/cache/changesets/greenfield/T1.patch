index 0000000..f6e7de8
--- /dev/null
+++ b/src/main/resources/application-write.yml
@@ -0,0 +1,14 @@
+# Deployment profile `write`: the management surface (create / lookup / delete short links).
+# Activate with SPRING_PROFILES_ACTIVE=write. Only write-side beans (@Profile("write")) are registered;
+# the redirect endpoint is not exposed by this deployment.
+# Write nodes allocate short codes from a global Redis counter in batches of
+# shortener.counter.batch-size and offset every value by shortener.counter.seed-offset (AMB-11).
+
+server:
+  port: ${SHORTENER_WRITE_PORT:8080}
+
+shortener:
+  base-url: ${SHORTENER_BASE_URL:http://localhost:8080}
+  counter:
+    batch-size: ${SHORTENER_COUNTER_BATCH_SIZE:1000}
+    seed-offset: ${SHORTENER_COUNTER_SEED_OFFSET:916132832}
diff --git a/src/main/resources/application.yml b/src/main/resources/application.yml
new file mode 100644
index 0000000..91ad872
--- /dev/null
+++ b/src/main/resources/application.yml
@@ -0,0 +1,62 @@
+# Shared configuration for every deployment surface.
+# Deployment-specific overrides live in application-read.yml / application-write.yml (Spring profiles `read` / `write`).
+# No credentials are committed here: every secret is read from the environment, with local-only defaults.
+
+spring:
+  application:
+    name: url-shortener
+  datasource:
+    url: ${SHORTENER_DB_URL:jdbc:postgresql://localhost:5432/shortener}
+    username: ${SHORTENER_DB_USERNAME:shortener}
+    password: ${SHORTENER_DB_PASSWORD:shortener}
+  jpa:
+    open-in-view: false
+    hibernate:
+      ddl-auto: validate
+  flyway:
+    enabled: true
+  data:
+    redis:
+      host: ${SHORTENER_REDIS_HOST:localhost}
+      port: ${SHORTENER_REDIS_PORT:6379}
+
+server:
+  port: 8080
+
+springdoc:
+  api-docs:
+    path: /v3/api-docs
+  swagger-ui:
+    path: /swagger-ui.html
+
+# Typed into com.example.shortener.config.ShortenerProperties; the values below are the documented defaults.
+shortener:
+  base-url: ${SHORTENER_BASE_URL:http://localhost:8080}
+  counter:
+    batch-size: 1000
+    seed-offset: 916132832
+  cache:
+    default-ttl: 24h
+
+---
+# Profile `openapi`: boots the application without any infrastructure so the `it` Maven profile
+# (spring-boot:start + springdoc-openapi-maven-plugin) can dump /v3/api-docs into target/openapi.json.
+# Nothing here may be used for a real deployment; it exists only for the contract gate.
+spring:
+  config:
+    activate:
+      on-profile: openapi
+  flyway:
+    enabled: false
+  jpa:
+    database: postgresql
+    database-platform: org.hibernate.dialect.PostgreSQLDialect
+    hibernate:
+      ddl-auto: none
+    properties:
+      hibernate:
+        boot:
+          allow_jdbc_metadata_access: false
+  datasource:
+    hikari:
+      initialization-fail-timeout: -1
