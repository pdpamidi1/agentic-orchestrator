index 0000000..d07aca6
--- /dev/null
+++ b/src/main/java/com/example/shortener/config/ShortenerProperties.java
@@ -0,0 +1,62 @@
+package com.example.shortener.config;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotNull;
+import jakarta.validation.constraints.Positive;
+import jakarta.validation.constraints.PositiveOrZero;
+import java.time.Duration;
+import org.springframework.boot.context.properties.ConfigurationProperties;
+import org.springframework.boot.context.properties.bind.DefaultValue;
+import org.springframework.validation.annotation.Validated;
+
+/**
+ * Typed configuration of the shortener, bound from the {@code shortener.*} keys.
+ *
+ * <p>This class is a leaf: it depends on nothing else inside the application.
+ *
+ * <ul>
+ *   <li>{@code shortener.base-url}: public base URL used to build short links (default {@value
+ *       #DEFAULT_BASE_URL}).
+ *   <li>{@code shortener.counter.batch-size}: number of counter values a write node reserves from
+ *       Redis in one round trip (default {@value #DEFAULT_COUNTER_BATCH_SIZE}).
+ *   <li>{@code shortener.counter.seed-offset}: value added to the global counter before encoding so
+ *       the first short codes are never trivially small (AMB-11, default {@value
+ *       #DEFAULT_COUNTER_SEED_OFFSET} = 62^5, i.e. every code is at least 6 base62 characters).
+ *   <li>{@code shortener.cache.default-ttl}: time a resolved mapping stays in the read cache when
+ *       the link carries no explicit expiry (AMB-9, default 24 hours).
+ * </ul>
+ *
+ * @param baseUrl public base URL, without trailing slash
+ * @param counter counter settings
+ * @param cache cache settings
+ */
+@Validated
+@ConfigurationProperties(prefix = "shortener")
+public record ShortenerProperties(
+    @DefaultValue(DEFAULT_BASE_URL) @NotBlank String baseUrl,
+    @DefaultValue @Valid @NotNull Counter counter,
+    @DefaultValue @Valid @NotNull Cache cache) {
+
+  public static final String DEFAULT_BASE_URL = "http://localhost:8080";
+  public static final long DEFAULT_COUNTER_BATCH_SIZE = 1_000L;
+  public static final long DEFAULT_COUNTER_SEED_OFFSET = 916_132_832L;
+  public static final Duration DEFAULT_CACHE_TTL = Duration.ofHours(24);
+
+  /**
+   * Counter allocation settings.
+   *
+   * @param batchSize counter values reserved per Redis round trip
+   * @param seedOffset offset added to the counter before encoding (AMB-11)
+   */
+  public record Counter(
+      @DefaultValue("1000") @Positive long batchSize,
+      @DefaultValue("916132832") @PositiveOrZero long seedOffset) {}
+
+  /**
+   * Read-cache settings.
+   *
+   * @param defaultTtl TTL applied to cached mappings without an explicit expiry (AMB-9)
+   */
+  public record Cache(@DefaultValue("24h") @NotNull Duration defaultTtl) {}
+}
diff --git a/src/main/resources/application-read.yml b/src/main/resources/application-read.yml
