+# Profile "write": the link-creation surface only.
+#
+#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=write
+#   SPRING_PROFILES_ACTIVE=write java -jar url-shortener.jar
+#
+# Registered under this profile: POST /api/v1/urls (createShortUrl), the batched Redis counter and the
+# Postgres sequence fallback (code_source = redis | db_sequence). Not registered: GET /{short_code}
+# (read controllers are @Profile("!write")), so a redirect request answers 404 (AC-14).
+#
+# All connection settings are inherited from application.yml and overridable via SHORTENER_* variables.
+
+spring:
+  application:
+    name: url-shortener-write
