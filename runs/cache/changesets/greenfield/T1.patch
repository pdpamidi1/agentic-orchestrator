+package com.example.shortener.config;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.Min;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotNull;
+import jakarta.validation.constraints.Pattern;
+import java.time.Duration;
+import org.springframework.boot.context.properties.ConfigurationProperties;
+import org.springframework.boot.context.properties.bind.DefaultValue;
+import org.springframework.validation.annotation.Validated;
+
+/**
+ * Application settings bound from the {@code shortener.*} prefix.
+ *
+ * <p>This class is a leaf: it depends on nothing inside the application. Documented defaults:
+ *
+ * <ul>
+ *   <li>{@code shortener.base-url} = {@value #DEFAULT_BASE_URL}: prefix of every generated short
+ *       URL.
+ *   <li>{@code shortener.counter.batch-size} = {@value #DEFAULT_COUNTER_BATCH_SIZE}: size of the
+ *       range reserved per Redis {@code INCRBY} (ADR-001).
+ *   <li>{@code shortener.counter.seed-offset} = {@value #DEFAULT_COUNTER_SEED_OFFSET}: 62^3, added
+ *       to every counter value so generated codes are at least three characters (AMB-11, ADR-004).
+ *   <li>{@code shortener.cache.default-ttl} = 24h: upper bound of a cache entry's TTL when the
+ *       mapping has no (or a later) expiry (AMB-9, ADR-005).
+ *   <li>{@code shortener.cache.key-prefix} = {@value #DEFAULT_CACHE_KEY_PREFIX}: Redis key prefix
+ *       of cached short-code to long-URL entries.
+ * </ul>
+ *
+ * @param baseUrl public base URL used to build {@code short_url}; must not end with a slash
+ * @param counter batched Redis counter settings
+ * @param cache read-through URL cache settings
+ */
+@Validated
+@ConfigurationProperties(prefix = "shortener")
+public record ShortenerProperties(
+    @DefaultValue(DEFAULT_BASE_URL) @NotBlank @Pattern(regexp = "^https?://.+[^/]$") String baseUrl,
+    @DefaultValue @Valid @NotNull Counter counter,
+    @DefaultValue @Valid @NotNull Cache cache) {
+
+  /** Default value of {@code shortener.base-url}. */
+  public static final String DEFAULT_BASE_URL = "http://localhost:8080";
+
+  /** Default value of {@code shortener.counter.batch-size}. */
+  public static final int DEFAULT_COUNTER_BATCH_SIZE = 1000;
+
+  /** Default value of {@code shortener.counter.seed-offset}: 62^3. */
+  public static final long DEFAULT_COUNTER_SEED_OFFSET = 238_328L;
+
+  /** Default value of {@code shortener.cache.default-ttl} (AMB-9). */
+  public static final Duration DEFAULT_CACHE_TTL = Duration.ofHours(24);
+
+  /** Default value of {@code shortener.cache.key-prefix}. */
+  public static final String DEFAULT_CACHE_KEY_PREFIX = "shortener:url:";
+
+  /**
+   * Settings of the short-code counter.
+   *
+   * @param batchSize number of counter values reserved per Redis {@code INCRBY}; at least 1
+   * @param seedOffset value added to every counter value before base62 encoding; non-negative
+   */
+  public record Counter(
+      @DefaultValue("" + DEFAULT_COUNTER_BATCH_SIZE) @Min(1) int batchSize,
+      @DefaultValue("" + DEFAULT_COUNTER_SEED_OFFSET) @Min(0) long seedOffset) {}
+
+  /**
+   * Settings of the Redis read-through cache.
+   *
+   * @param defaultTtl TTL used when a mapping never expires, and the ceiling of the TTL otherwise
+   * @param keyPrefix prefix of the Redis keys holding cached short-code to long-URL entries
+   */
+  public record Cache(
+      @DefaultValue("24h") @NotNull Duration defaultTtl,
+      @DefaultValue(DEFAULT_CACHE_KEY_PREFIX) @NotBlank String keyPrefix) {}
+}
diff --git a/src/main/resources/application-read.yml b/src/main/resources/application-read.yml
