+++ b/src/main/resources/application-read.yml
@@ -0,0 +1,15 @@
+# Profile "read": the redirect surface only.
+#
+#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=read
+#   SPRING_PROFILES_ACTIVE=read java -jar url-shortener.jar
+#
+# Registered under this profile: GET /{short_code} (redirectToLongUrl) and its Redis read-through cache.
+# Not registered: POST /api/v1/urls (write controllers are @Profile("!read")), so a POST answers 404
+# (AC-14). The read surface never allocates short codes and never writes to Postgres; it serves from
+# the Redis cache first and falls back to Postgres on a miss or when Redis is unreachable.
+#
+# All connection settings are inherited from application.yml and overridable via SHORTENER_* variables.
+
+spring:
+  application:
+    name: url-shortener-read
