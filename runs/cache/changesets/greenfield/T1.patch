index 0000000..2a762da
--- /dev/null
+++ b/src/main/resources/application-read.yml
@@ -0,0 +1,12 @@
+# Deployment profile `read`: the redirect surface (GET /{code}).
+# Activate with SPRING_PROFILES_ACTIVE=read. Only read-side beans (@Profile("read")) are registered;
+# the write API is not exposed by this deployment.
+# Read nodes are stateless and horizontally scalable; they consult the Redis cache first and fall
+# back to PostgreSQL on a miss, caching the result for shortener.cache.default-ttl (AMB-9).
+
+server:
+  port: ${SHORTENER_READ_PORT:8080}
+
+shortener:
+  cache:
+    default-ttl: ${SHORTENER_CACHE_DEFAULT_TTL:24h}
