new file mode 100644
index 0000000..88ccebc
--- /dev/null
+++ b/src/main/resources/application.yml
@@ -0,0 +1,58 @@
+# Shared configuration of the URL shortener (all profiles).
+#
+# Deployment profiles (ADR-007):
+#   (none)  - default: both the write surface (POST /api/v1/urls) and the read surface (GET /{short_code})
+#   write   - only the write surface; read controllers are not registered  (see application-write.yml)
+#   read    - only the read surface;  write controllers are not registered (see application-read.yml)
+#
+# Every connection setting can be overridden through the environment variables named below. The
+# values after the ':' are local development defaults only; real deployments must supply their own.
+
+spring:
+  application:
+    name: url-shortener
+
+  datasource:
+    url: ${SHORTENER_DB_URL:jdbc:postgresql://localhost:5432/shortener}
+    username: ${SHORTENER_DB_USERNAME:shortener}
+    password: ${SHORTENER_DB_PASSWORD:}
+    hikari:
+      maximum-pool-size: ${SHORTENER_DB_POOL_SIZE:10}
+
+  jpa:
+    open-in-view: false
+    hibernate:
+      # The schema is owned by Flyway (ADR-010); Hibernate only validates the mapping.
+      ddl-auto: validate
+
+  flyway:
+    enabled: true
+    locations: classpath:db/migration
+
+  data:
+    redis:
+      host: ${SHORTENER_REDIS_HOST:localhost}
+      port: ${SHORTENER_REDIS_PORT:6379}
+      timeout: ${SHORTENER_REDIS_TIMEOUT:500ms}
+
+server:
+  port: ${SERVER_PORT:8080}
+
+springdoc:
+  api-docs:
+    path: /v3/api-docs
+  swagger-ui:
+    path: /swagger-ui.html
+
+shortener:
+  # Public prefix of generated short URLs (no trailing slash).
+  base-url: ${SHORTENER_BASE_URL:http://localhost:8080}
+  counter:
+    # Values reserved per Redis INCRBY (ADR-001). Unused values are discarded on restart (AMB-10).
+    batch-size: ${SHORTENER_COUNTER_BATCH_SIZE:1000}
+    # 62^3, so every generated code is at least three characters (AMB-11, ADR-004).
+    seed-offset: ${SHORTENER_COUNTER_SEED_OFFSET:238328}
+  cache:
+    # TTL = min(remaining time to expires_at, default-ttl) (AMB-9, ADR-005).
+    default-ttl: ${SHORTENER_CACHE_DEFAULT_TTL:24h}
+    key-prefix: "shortener:url:"
