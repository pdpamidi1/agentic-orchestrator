@@ -0,0 +1,105 @@
+package com.example.shortener.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.time.Duration;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.context.properties.EnableConfigurationProperties;
+import org.springframework.boot.context.properties.bind.Binder;
+import org.springframework.boot.context.properties.source.MapConfigurationPropertySource;
+import org.springframework.boot.test.context.runner.ApplicationContextRunner;
+
+/**
+ * Unit tests of the documented defaults and binding of {@link ShortenerProperties}; no database.
+ */
+class ShortenerPropertiesTest {
+
+  private static ShortenerProperties bind(Map<String, String> properties) {
+    return new Binder(new MapConfigurationPropertySource(properties))
+        .bindOrCreate("shortener", ShortenerProperties.class);
+  }
+
+  @Test
+  void defaultsMatchTheDocumentedValues() {
+    ShortenerProperties properties = bind(Map.of());
+
+    assertThat(properties.baseUrl()).isEqualTo("http://localhost:8080");
+    assertThat(properties.counter().batchSize()).isEqualTo(1000);
+    assertThat(properties.counter().seedOffset()).isEqualTo(238_328L);
+    assertThat(properties.cache().defaultTtl()).isEqualTo(Duration.ofHours(24));
+    assertThat(properties.cache().keyPrefix()).isEqualTo("shortener:url:");
+  }
+
+  @Test
+  void seedOffsetIsSixtyTwoCubed() {
+    assertThat(ShortenerProperties.DEFAULT_COUNTER_SEED_OFFSET).isEqualTo(62L * 62L * 62L);
+    assertThat(bind(Map.of()).counter().seedOffset())
+        .isEqualTo(ShortenerProperties.DEFAULT_COUNTER_SEED_OFFSET);
+  }
+
+  @Test
+  void relaxedPropertyNamesOverrideEveryDefault() {
+    ShortenerProperties properties =
+        bind(
+            Map.of(
+                "shortener.base-url", "https://sho.rt",
+                "shortener.counter.batch-size", "250",
+                "shortener.counter.seed-offset", "0",
+                "shortener.cache.default-ttl", "5m",
+                "shortener.cache.key-prefix", "test:url:"));
+
+    assertThat(properties.baseUrl()).isEqualTo("https://sho.rt");
+    assertThat(properties.counter().batchSize()).isEqualTo(250);
+    assertThat(properties.counter().seedOffset()).isZero();
+    assertThat(properties.cache().defaultTtl()).isEqualTo(Duration.ofMinutes(5));
+    assertThat(properties.cache().keyPrefix()).isEqualTo("test:url:");
+  }
+
+  @Test
+  void partialOverrideKeepsTheRemainingDefaults() {
+    ShortenerProperties properties = bind(Map.of("shortener.counter.batch-size", "50"));
+
+    assertThat(properties.counter().batchSize()).isEqualTo(50);
+    assertThat(properties.counter().seedOffset()).isEqualTo(238_328L);
+    assertThat(properties.baseUrl()).isEqualTo("http://localhost:8080");
+    assertThat(properties.cache().defaultTtl()).isEqualTo(Duration.ofHours(24));
+  }
+
+  @Test
+  void beanIsRegisteredAndValidatedByTheApplicationContext() {
+    new ApplicationContextRunner()
+        .withUserConfiguration(PropertiesConfiguration.class)
+        .run(
+            context -> {
+              assertThat(context).hasSingleBean(ShortenerProperties.class);
+              ShortenerProperties properties = context.getBean(ShortenerProperties.class);
+              assertThat(properties.baseUrl()).isEqualTo("http://localhost:8080");
+              assertThat(properties.counter().batchSize()).isEqualTo(1000);
+              assertThat(properties.cache().defaultTtl()).isEqualTo(Duration.ofHours(24));
+            });
+  }
+
+  @Test
+  void invalidValuesAreRejectedByBeanValidation() {
+    new ApplicationContextRunner()
+        .withUserConfiguration(PropertiesConfiguration.class)
+        .withPropertyValues("shortener.counter.batch-size=0")
+        .run(context -> assertThat(context).hasFailed());
+
+    new ApplicationContextRunner()
+        .withUserConfiguration(PropertiesConfiguration.class)
+        .withPropertyValues("shortener.base-url=http://localhost:8080/")
+        .run(context -> assertThat(context).hasFailed());
+  }
+
+  @Test
+  void unparsableDurationFailsBinding() {
+    assertThatThrownBy(() -> bind(Map.of("shortener.cache.default-ttl", "yesterday")))
+        .isInstanceOf(RuntimeException.class);
+  }
+
+  @EnableConfigurationProperties(ShortenerProperties.class)
+  static class PropertiesConfiguration {}
+}
