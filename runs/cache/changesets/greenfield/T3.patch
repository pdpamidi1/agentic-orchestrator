@@ -0,0 +1,25 @@
+package com.example.shortener.domain;
+
+import java.util.Optional;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+
+/** Spring Data JPA access to the {@code urls} table and the fallback counter sequence. */
+public interface UrlMappingRepository extends JpaRepository<UrlMapping, String> {
+
+  /** Name of the Postgres sequence backing {@link #nextCodeSequenceValue()}. */
+  String CODE_SEQUENCE_NAME = "url_code_seq";
+
+  /** Whether a mapping with the given short code already exists. */
+  boolean existsByShortCode(String shortCode);
+
+  /** Looks up a mapping by its short code. */
+  Optional<UrlMapping> findByShortCode(String shortCode);
+
+  /**
+   * Reserves the next value of the fallback counter sequence {@code url_code_seq}. Used by the
+   * short-code allocator when Redis is unavailable ({@link CodeSource#DB_SEQUENCE}).
+   */
+  @Query(value = "SELECT nextval('url_code_seq')", nativeQuery = true)
+  long nextCodeSequenceValue();
+}
diff --git a/src/main/resources/db/migration/V1__create_urls_table.sql b/src/main/resources/db/migration/V1__create_urls_table.sql
new file mode 100644
index 0000000..54c76c7
--- /dev/null
+++ b/src/main/resources/db/migration/V1__create_urls_table.sql
@@ -0,0 +1,29 @@
+-- V1: url mappings table and the database fallback counter sequence.
+--
+-- urls: one row per short code. Mapped 1:1 by com.example.shortener.domain.UrlMapping
+-- (Hibernate runs with ddl-auto=validate, so entity and DDL must stay in sync).
+--
+-- url_code_seq: fallback counter used by the short-code allocator when Redis is unavailable
+-- (code_source = 'db_sequence'). It is seeded past the AMB-11 seed offset (62^5 = 916132832,
+-- see shortener.counter.seed-offset) so every value it yields already encodes to at least
+-- 6 base62 characters and never overlaps the trivially small range.
+
+CREATE TABLE urls (
+    short_code   VARCHAR(32)   NOT NULL,
+    long_url     VARCHAR(2048) NOT NULL,
+    created_at   TIMESTAMPTZ   NOT NULL,
+    expires_at   TIMESTAMPTZ   NULL,
+    created_by   VARCHAR(255)  NULL,
+    code_source  VARCHAR(16)   NOT NULL,
+    CONSTRAINT pk_urls PRIMARY KEY (short_code),
+    CONSTRAINT ck_urls_code_source CHECK (code_source IN ('redis', 'db_sequence'))
+);
+
+-- Supports expiry lookups / purges ("WHERE expires_at <= now()"); rows without expiry are skipped.
+CREATE INDEX idx_urls_expires_at ON urls (expires_at) WHERE expires_at IS NOT NULL;
+
+CREATE SEQUENCE url_code_seq
+    AS BIGINT
+    START WITH 916132833
+    INCREMENT BY 1
+    NO CYCLE;
diff --git a/src/test/java/com/example/shortener/api/dto/CreateUrlRequestValidationTest.java b/src/test/java/com/example/shortener/api/dto/CreateUrlRequestValidationTest.java
new file mode 100644
index 0000000..db8348e
--- /dev/null
+++ b/src/test/java/com/example/shortener/api/dto/CreateUrlRequestValidationTest.java
@@ -0,0 +1,291 @@
+package com.example.shortener.api.dto;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import jakarta.validation.ConstraintViolation;
+import jakarta.validation.Validation;
+import jakarta.validation.Validator;
+import jakarta.validation.ValidatorFactory;
+import java.time.OffsetDateTime;
+import java.time.ZoneOffset;
+import java.util.Set;
+import java.util.stream.Collectors;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import tools.jackson.core.JacksonException;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+/**
+ * AC-2 / AC-5 / AC-6: Bean Validation rules of {@link CreateUrlRequest} and the JSON contract of
+ * both DTOs, exercised without a Spring context.
+ */
+class CreateUrlRequestValidationTest {
+
+  private static final String VALID_URL = "https://example.com/some/path?q=1";
+  private static final OffsetDateTime FUTURE = OffsetDateTime.now(ZoneOffset.UTC).plusDays(1);
+  private static final OffsetDateTime PAST = OffsetDateTime.now(ZoneOffset.UTC).minusMinutes(1);
+
+  private static ValidatorFactory factory;
+  private static Validator validator;
+  private static final JsonMapper JSON = JsonMapper.builder().build();
+
+  @BeforeAll
+  static void setUp() {
+    factory = Validation.buildDefaultValidatorFactory();
+    validator = factory.getValidator();
+  }
+
+  @AfterAll
+  static void tearDown() {
+    factory.close();
+  }
+
+  private static Set<String> violatedProperties(CreateUrlRequest request) {
+    return validator.validate(request).stream()
+        .map(ConstraintViolation::getPropertyPath)
+        .map(Object::toString)
+        .collect(Collectors.toSet());
+  }
+
+  // ------------------------------------------------------------------ valid input
+
+  @Test
+  void validRequestWithAllFieldsHasNoViolations() {
+    CreateUrlRequest request = new CreateUrlRequest(VALID_URL, "promo2024", FUTURE);
+
+    assertThat(validator.validate(request)).isEmpty();
+  }
+
+  @Test
+  void validRequestWithOnlyLongUrlHasNoViolations() {
+    CreateUrlRequest request = new CreateUrlRequest("http://example.com", null, null);
+
+    assertThat(validator.validate(request)).isEmpty();
+  }
+
+  @Test
+  void schemeIsCaseInsensitive() {
+    assertThat(validator.validate(new CreateUrlRequest("HTTPS://example.com", null, null)))
+        .isEmpty();
+  }
+
+  // ------------------------------------------------------------------ AC-2: long_url
+
+  @Test
+  void ac2_ftpSchemeIsRejected() {
+    assertThat(violatedProperties(new CreateUrlRequest("ftp://example.com/file", null, null)))
+        .containsExactly("longUrl");
+  }
+
+  @Test
+  void ac2_schemeRelativeAndSchemelessUrlsAreRejected() {
+    assertThat(violatedProperties(new CreateUrlRequest("//example.com", null, null)))
+        .containsExactly("longUrl");
+    assertThat(violatedProperties(new CreateUrlRequest("example.com/path", null, null)))
+        .containsExactly("longUrl");
+    assertThat(violatedProperties(new CreateUrlRequest("javascript:alert(1)", null, null)))
+        .containsExactly("longUrl");
+  }
+
+  @Test
+  void ac2_schemeWithoutHostIsRejected() {
+    assertThat(violatedProperties(new CreateUrlRequest("https://", null, null)))
+        .containsExactly("longUrl");
+  }
+
+  @Test
+  void ac2_urlContainingWhitespaceIsRejected() {
+    assertThat(violatedProperties(new CreateUrlRequest("https://exa mple.com", null, null)))
+        .containsExactly("longUrl");
+  }
+
+  @Test
+  void ac2_blankAndNullLongUrlAreRejected() {
+    assertThat(violatedProperties(new CreateUrlRequest("", null, null))).containsExactly("longUrl");
+    assertThat(violatedProperties(new CreateUrlRequest("   ", null, null)))
+        .containsExactly("longUrl");
+    assertThat(violatedProperties(new CreateUrlRequest(null, null, null)))
+        .containsExactly("longUrl");
+  }
+
+  @Test
+  void ac2_longUrlAbove2048CharactersIsRejected() {
+    String prefix = "https://example.com/";
+    String tooLong = prefix + "a".repeat(2049 - prefix.length());
+    assertThat(tooLong).hasSize(2049);
+
+    assertThat(violatedProperties(new CreateUrlRequest(tooLong, null, null)))
+        .containsExactly("longUrl");
+  }
+
+  @Test
+  void ac2_longUrlOfExactly2048CharactersIsAccepted() {
+    String prefix = "https://example.com/";
+    String maxLength = prefix + "a".repeat(2048 - prefix.length());
+    assertThat(maxLength).hasSize(CreateUrlRequest.LONG_URL_MAX_LENGTH);
+
+    assertThat(validator.validate(new CreateUrlRequest(maxLength, null, null))).isEmpty();
+  }
+
+  // ------------------------------------------------------------------ AC-5: custom_alias
+
+  @Test
+  void ac5_aliasWithCharactersOutsideAlphanumericIsRejected() {
+    assertThat(violatedProperties(new CreateUrlRequest(VALID_URL, "promo-2024", null)))
+        .containsExactly("customAlias");
+    assertThat(violatedProperties(new CreateUrlRequest(VALID_URL, "promo_2024", null)))
+        .containsExactly("customAlias");
+    assertThat(violatedProperties(new CreateUrlRequest(VALID_URL, "prömo", null)))
+        .containsExactly("customAlias");
+    assertThat(violatedProperties(new CreateUrlRequest(VALID_URL, "pro mo", null)))
+        .containsExactly("customAlias");
+  }
+
+  @Test
+  void ac5_aliasOfLength2IsRejected() {
+    assertThat(violatedProperties(new CreateUrlRequest(VALID_URL, "ab", null)))
+        .containsExactly("customAlias");
+  }
+
+  @Test
+  void ac5_aliasOfLength33IsRejected() {
+    String alias = "a".repeat(33);
+
+    assertThat(violatedProperties(new CreateUrlRequest(VALID_URL, alias, null)))
+        .containsExactly("customAlias");
+  }
+
+  @Test
+  void ac5_aliasBoundaryLengths3And32AreAccepted() {
+    assertThat(validator.validate(new CreateUrlRequest(VALID_URL, "abc", null))).isEmpty();
+    assertThat(validator.validate(new CreateUrlRequest(VALID_URL, "Z9".repeat(16), null)))
+        .isEmpty();
+  }
+
+  @Test
+  void ac5_emptyAliasIsRejected() {
+    assertThat(violatedProperties(new CreateUrlRequest(VALID_URL, "", null)))
+        .containsExactly("customAlias");
+  }
+
+  // ------------------------------------------------------------------ AC-6: expiration_date
+
+  @Test
+  void ac6_pastExpirationDateIsRejected() {
+    assertThat(violatedProperties(new CreateUrlRequest(VALID_URL, null, PAST)))
+        .containsExactly("expirationDate");
+  }
+
+  @Test
+  void ac6_futureExpirationDateIsAccepted() {
+    assertThat(validator.validate(new CreateUrlRequest(VALID_URL, null, FUTURE))).isEmpty();
+  }
+
+  @Test
+  void ac6_malformedExpirationDateFailsToDeserialise() {
+    String json =
+        """
+        {"long_url":"https://example.com","expiration_date":"not-a-date"}
+        """;
+
+    assertThatThrownBy(() -> JSON.readValue(json, CreateUrlRequest.class))
+        .isInstanceOf(JacksonException.class);
+  }
+
+  @Test
+  void ac6_dateWithoutOffsetFailsToDeserialise() {
+    String json =
+        """
+        {"long_url":"https://example.com","expiration_date":"2030-01-01T00:00:00"}
+        """;
+
+    assertThatThrownBy(() -> JSON.readValue(json, CreateUrlRequest.class))
+        .isInstanceOf(JacksonException.class);
+  }
+
+  @Test
+  void ac6_iso8601OffsetDateTimeIsParsed() {
+    String json =
+        """
+        {"long_url":"https://example.com","custom_alias":"abc",
+         "expiration_date":"2030-01-01T12:30:00+02:00"}
+        """;
+
+    CreateUrlRequest request = JSON.readValue(json, CreateUrlRequest.class);
+
+    assertThat(request.longUrl()).isEqualTo("https://example.com");
+    assertThat(request.customAlias()).isEqualTo("abc");
+    assertThat(request.expirationDate())
+        .isNotNull()
+        .satisfies(
+            date ->
+                assertThat(date.toInstant())
+                    .isEqualTo(OffsetDateTime.parse("2030-01-01T12:30:00+02:00").toInstant()));
+  }
+
+  // ------------------------------------------------------------------ JSON contract
+
+  @Test
+  void requestUsesSnakeCaseJsonNames() {
+    String json =
+        """
+        {"long_url":"https://example.com","custom_alias":"abc","expiration_date":null}
+        """;
+
+    CreateUrlRequest request = JSON.readValue(json, CreateUrlRequest.class);
+
+    assertThat(request.longUrl()).isEqualTo("https://example.com");
+    assertThat(request.customAlias()).isEqualTo("abc");
+    assertThat(request.expirationDate()).isNull();
+  }
+
+  @Test
+  void requestIgnoresCamelCaseNames() {
+    String json =
+        """
+        {"longUrl":"https://example.com","customAlias":"abc"}
+        """;
+
+    CreateUrlRequest request = JSON.readValue(json, CreateUrlRequest.class);
+
+    assertThat(request.longUrl()).isNull();
+    assertThat(request.customAlias()).isNull();
+  }
+
+  @Test
+  void responseSerialisesInSnakeCaseWithIsoDates() {
+    OffsetDateTime expiresAt = OffsetDateTime.parse("2030-01-01T00:00:00Z");
+    CreateUrlResponse response =
+        new CreateUrlResponse(
+            "http://localhost:8080/abc123", "abc123", "https://example.com", expiresAt, "redis");
+
+    JsonNode node = JSON.readTree(JSON.writeValueAsString(response));
+
+    assertThat(node.get("short_url").asString()).isEqualTo("http://localhost:8080/abc123");
+    assertThat(node.get("short_code").asString()).isEqualTo("abc123");
+    assertThat(node.get("long_url").asString()).isEqualTo("https://example.com");
+    assertThat(node.get("code_source").asString()).isEqualTo("redis");
+    assertThat(node.get("expires_at").isString()).isTrue();
+    assertThat(OffsetDateTime.parse(node.get("expires_at").asString()).toInstant())
+        .isEqualTo(expiresAt.toInstant());
+    assertThat(node.propertyNames())
+        .containsExactlyInAnyOrder(
+            "short_url", "short_code", "long_url", "expires_at", "code_source");
+  }
+
+  @Test
+  void responseWithoutExpiryKeepsExpiresAtNull() {
+    CreateUrlResponse response =
+        new CreateUrlResponse(
+            "http://localhost:8080/abc123", "abc123", "https://example.com", null, "db_sequence");
+
+    JsonNode node = JSON.readTree(JSON.writeValueAsString(response));
+
+    assertThat(node.has("expires_at")).isTrue();
+    assertThat(node.get("expires_at").isNull()).isTrue();
+    assertThat(node.get("code_source").asString()).isEqualTo("db_sequence");
+  }
+}
