@@ -0,0 +1,25 @@
+package com.example.shortener.api.dto;
+
+import com.fasterxml.jackson.annotation.JsonProperty;
+import java.time.OffsetDateTime;
+
+/**
+ * Response body of {@code POST /api/v1/urls} (operationId {@code createShortUrl}), serialised in
+ * snake_case.
+ *
+ * <p>{@code code_source} is the textual value persisted in {@code urls.code_source} ({@code
+ * "redis"} or {@code "db_sequence"}); this package deliberately does not depend on the domain enum
+ * so the API layer stays a leaf.
+ *
+ * @param shortUrl absolute short link (configured base URL plus the short code)
+ * @param shortCode the short code, generated or the custom alias
+ * @param longUrl the destination URL as stored
+ * @param expiresAt expiry moment, or {@code null} when the link does not expire
+ * @param codeSource origin of the short code ({@code "redis"} or {@code "db_sequence"})
+ */
+public record CreateUrlResponse(
+    @JsonProperty("short_url") String shortUrl,
+    @JsonProperty("short_code") String shortCode,
+    @JsonProperty("long_url") String longUrl,
+    @JsonProperty("expires_at") OffsetDateTime expiresAt,
+    @JsonProperty("code_source") String codeSource) {}
diff --git a/src/main/java/com/example/shortener/api/error/AliasAlreadyExistsException.java b/src/main/java/com/example/shortener/api/error/AliasAlreadyExistsException.java
