+package com.example.shortener.api.error;
+
+/**
+ * Thrown when the resolved mapping's {@code expires_at} lies in the past. Rendered as {@code 410
+ * Gone} by {@link GlobalExceptionHandler}.
+ */
+public class ShortCodeExpiredException extends RuntimeException {
+
+  private final String shortCode;
+
+  /**
+   * @param shortCode the expired short code
+   */
+  public ShortCodeExpiredException(String shortCode) {
+    super("Short code '" + shortCode + "' has expired");
+    this.shortCode = shortCode;
+  }
+
+  /** The expired short code. */
+  public String getShortCode() {
+    return shortCode;
+  }
+}
