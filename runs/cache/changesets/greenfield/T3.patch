+package com.example.shortener.api.error;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.example.shortener.api.dto.CreateUrlRequest;
+import jakarta.validation.Valid;
+import org.hamcrest.Matchers;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+import org.springframework.test.web.servlet.ResultActions;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+/**
+ * AC-2 / AC-5 / AC-6 / AC-16: every mapped exception is rendered by {@link GlobalExceptionHandler}
+ * as {@code application/problem+json} with the consistent field set {@code type}, {@code title},
+ * {@code status}, {@code detail}, {@code instance} and without internal details.
+ *
+ * <p>Uses a standalone MockMvc with a stub controller so that no production controller (T5/T6) is
+ * required.
+ */
+class GlobalExceptionHandlerTest {
+
+  private static final String INTERNAL_SECRET = "jdbc:postgresql://db:5432/shortener?password=s3";
+
+  private MockMvc mvc;
+
+  @BeforeEach
+  void setUp() {
+    mvc =
+        MockMvcBuilders.standaloneSetup(new ThrowingController())
+            .setControllerAdvice(new GlobalExceptionHandler())
+            .build();
+  }
+
+  // ------------------------------------------------------------------ AC-2 / AC-5 / AC-6: 400
+
+  @Test
+  void ac2_invalidLongUrlYields400ValidationProblem() throws Exception {
+    postJson("{\"long_url\":\"ftp://example.com/file\"}")
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:validation-error"))
+        .andExpect(jsonPath("$.title").value("Validation failed"))
+        .andExpect(jsonPath("$.status").value(400))
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("long_url:")))
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("http or https")))
+        .andExpect(jsonPath("$.instance").value("/api/v1/urls"));
+  }
+
+  @Test
+  void ac2_blankLongUrlYields400() throws Exception {
+    postJson("{\"long_url\":\"\"}")
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:validation-error"))
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("long_url:")));
+  }
+
+  @Test
+  void ac2_missingLongUrlYields400() throws Exception {
+    postJson("{}")
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson())
+        .andExpect(
+            jsonPath("$.detail").value(Matchers.containsString("long_url: must not be blank")));
+  }
+
+  @Test
+  void ac2_longUrlAbove2048CharactersYields400() throws Exception {
+    String url = "https://example.com/" + "a".repeat(2049 - "https://example.com/".length());
+
+    postJson("{\"long_url\":\"" + url + "\"}")
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("at most 2048")));
+  }
+
+  @Test
+  void ac5_invalidAliasYields400WithSnakeCaseFieldName() throws Exception {
+    postJson("{\"long_url\":\"https://example.com\",\"custom_alias\":\"bad-alias!\"}")
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:validation-error"))
+        .andExpect(jsonPath("$.status").value(400))
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("custom_alias:")))
+        .andExpect(
+            jsonPath("$.detail").value(Matchers.not(Matchers.containsString("customAlias"))));
+  }
+
+  @Test
+  void ac5_aliasTooShortAndTooLongYield400() throws Exception {
+    postJson("{\"long_url\":\"https://example.com\",\"custom_alias\":\"ab\"}")
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson());
+    postJson("{\"long_url\":\"https://example.com\",\"custom_alias\":\"" + "a".repeat(33) + "\"}")
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson());
+  }
+
+  @Test
+  void ac6_pastExpirationDateYields400() throws Exception {
+    postJson("{\"long_url\":\"https://example.com\",\"expiration_date\":\"2000-01-01T00:00:00Z\"}")
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:validation-error"))
+        .andExpect(jsonPath("$.detail").value("expiration_date: must be in the future"));
+  }
+
+  @Test
+  void ac6_malformedExpirationDateYields400MalformedBodyProblem() throws Exception {
+    postJson("{\"long_url\":\"https://example.com\",\"expiration_date\":\"tomorrow\"}")
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:malformed-request-body"))
+        .andExpect(jsonPath("$.title").value("Malformed request body"))
+        .andExpect(jsonPath("$.status").value(400))
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("ISO-8601")))
+        .andExpect(jsonPath("$.instance").value("/api/v1/urls"))
+        // Parser internals (class names, source location) must not leak.
+        .andExpect(jsonPath("$.detail").value(Matchers.not(Matchers.containsString("java.time"))))
+        .andExpect(jsonPath("$.detail").value(Matchers.not(Matchers.containsString("Jackson"))));
+  }
+
+  @Test
+  void unreadableJsonBodyYields400MalformedBodyProblem() throws Exception {
+    postJson("{\"long_url\": ")
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:malformed-request-body"))
+        .andExpect(jsonPath("$.status").value(400));
+  }
+
+  @Test
+  void invalidUrlExceptionYields400() throws Exception {
+    mvc.perform(get("/throw/invalid-url"))
+        .andExpect(status().isBadRequest())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:invalid-url"))
+        .andExpect(jsonPath("$.title").value("Invalid URL"))
+        .andExpect(jsonPath("$.status").value(400))
+        .andExpect(jsonPath("$.detail").value("URL host is not allowed"))
+        .andExpect(jsonPath("$.instance").value("/throw/invalid-url"));
+  }
+
+  // ------------------------------------------------------------------ AC-16: 404 / 409 / 410
+
+  @Test
+  void ac16_shortCodeNotFoundYields404() throws Exception {
+    mvc.perform(get("/throw/not-found"))
+        .andExpect(status().isNotFound())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:short-code-not-found"))
+        .andExpect(jsonPath("$.title").value("Short code not found"))
+        .andExpect(jsonPath("$.status").value(404))
+        .andExpect(jsonPath("$.detail").value("Short code 'nope42' does not exist"))
+        .andExpect(jsonPath("$.instance").value("/throw/not-found"));
+  }
+
+  @Test
+  void ac16_aliasAlreadyExistsYields409() throws Exception {
+    mvc.perform(get("/throw/conflict"))
+        .andExpect(status().isConflict())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:alias-already-exists"))
+        .andExpect(jsonPath("$.title").value("Alias already exists"))
+        .andExpect(jsonPath("$.status").value(409))
+        .andExpect(jsonPath("$.detail").value("Short code 'promo2024' is already taken"))
+        .andExpect(jsonPath("$.instance").value("/throw/conflict"));
+  }
+
+  @Test
+  void ac16_shortCodeExpiredYields410() throws Exception {
+    mvc.perform(get("/throw/expired"))
+        .andExpect(status().isGone())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:short-code-expired"))
+        .andExpect(jsonPath("$.title").value("Short code expired"))
+        .andExpect(jsonPath("$.status").value(410))
+        .andExpect(jsonPath("$.detail").value("Short code 'old123' has expired"))
+        .andExpect(jsonPath("$.instance").value("/throw/expired"));
+  }
+
+  // ------------------------------------------------------------------ AC-16: 500
+
+  @Test
+  void ac16_unhandledExceptionYields500WithoutInternalDetails() throws Exception {
+    MvcResult result =
+        mvc.perform(get("/throw/boom"))
+            .andExpect(status().isInternalServerError())
+            .andExpect(problemJson())
+            .andExpect(jsonPath("$.type").value("urn:shortener:problem:internal-error"))
+            .andExpect(jsonPath("$.title").value("Internal server error"))
+            .andExpect(jsonPath("$.status").value(500))
+            .andExpect(
+                jsonPath("$.detail")
+                    .value("An unexpected error occurred while processing the request."))
+            .andExpect(jsonPath("$.instance").value("/throw/boom"))
+            .andReturn();
+
+    String body = result.getResponse().getContentAsString();
+    assertThat(body)
+        .doesNotContain(INTERNAL_SECRET)
+        .doesNotContain("IllegalStateException")
+        .doesNotContain("stackTrace")
+        .doesNotContain("trace")
+        .doesNotContain("exception")
+        .doesNotContain("at com.example");
+  }
+
+  @Test
+  void ac16_unhandledErrorSubclassIsAlsoRenderedAs500() throws Exception {
+    mvc.perform(get("/throw/error"))
+        .andExpect(status().isInternalServerError())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:internal-error"))
+        .andExpect(jsonPath("$.status").value(500));
+  }
+
+  // ------------------------------------------------------------------ AC-16: consistency
+
+  @Test
+  void ac16_everyProblemCarriesExactlyTheDocumentedFields() throws Exception {
+    for (String path :
+        new String[] {
+          "/throw/invalid-url",
+          "/throw/not-found",
+          "/throw/conflict",
+          "/throw/expired",
+          "/throw/boom"
+        }) {
+      mvc.perform(get(path))
+          .andExpect(problemJson())
+          .andExpect(jsonPath("$.type").isString())
+          .andExpect(jsonPath("$.title").isString())
+          .andExpect(jsonPath("$.status").isNumber())
+          .andExpect(jsonPath("$.detail").isString())
+          .andExpect(jsonPath("$.instance").value(path))
+          .andExpect(jsonPath("$.*", Matchers.hasSize(5)));
+    }
+  }
+
+  @Test
+  void ac16_frameworkHandledErrorsUseTheSameTypeSchemeAndInstance() throws Exception {
+    // 405 comes from ResponseEntityExceptionHandler, not from one of our @ExceptionHandler methods.
+    mvc.perform(get("/api/v1/urls"))
+        .andExpect(status().isMethodNotAllowed())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.type").value("urn:shortener:problem:method-not-allowed"))
+        .andExpect(jsonPath("$.status").value(405))
+        .andExpect(jsonPath("$.instance").value("/api/v1/urls"));
+  }
+
+  @Test
+  void problemIsReturnedEvenWhenClientAcceptsOnlyApplicationJson() throws Exception {
+    mvc.perform(get("/throw/not-found").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isNotFound())
+        .andExpect(problemJson())
+        .andExpect(jsonPath("$.status").value(404));
+  }
+
+  @Test
+  void toSnakeCaseMapsJavaPropertyNamesToJsonNames() {
+    assertThat(GlobalExceptionHandler.toSnakeCase("longUrl")).isEqualTo("long_url");
+    assertThat(GlobalExceptionHandler.toSnakeCase("customAlias")).isEqualTo("custom_alias");
+    assertThat(GlobalExceptionHandler.toSnakeCase("expirationDate")).isEqualTo("expiration_date");
+    assertThat(GlobalExceptionHandler.toSnakeCase("plain")).isEqualTo("plain");
+  }
+
+  // ------------------------------------------------------------------ helpers
+
+  private ResultActions postJson(String body) throws Exception {
+    return mvc.perform(post("/api/v1/urls").contentType(MediaType.APPLICATION_JSON).content(body));
+  }
+
+  private static org.springframework.test.web.servlet.ResultMatcher problemJson() {
+    return content().contentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON);
+  }
+
+  /** Stub endpoints that raise each mapped exception; replaced by the real controllers in T5/T6. */
+  @RestController
+  static class ThrowingController {
+
+    @PostMapping("/api/v1/urls")
+    @ResponseStatus(HttpStatus.CREATED)
+    String create(@Valid @RequestBody CreateUrlRequest request) {
+      return "created";
+    }
+
+    @GetMapping("/throw/invalid-url")
+    String invalidUrl() {
+      throw new InvalidUrlException("URL host is not allowed");
+    }
+
+    @GetMapping("/throw/not-found")
+    String notFound() {
+      throw new ShortCodeNotFoundException("nope42");
+    }
+
+    @GetMapping("/throw/conflict")
+    String conflict() {
+      throw new AliasAlreadyExistsException("promo2024");
+    }
+
+    @GetMapping("/throw/expired")
+    String expired() {
+      throw new ShortCodeExpiredException("old123");
+    }
+
+    @GetMapping("/throw/boom")
+    String boom() {
+      throw new IllegalStateException("connection failed: " + INTERNAL_SECRET);
+    }
+
+    @GetMapping("/throw/error")
+    String error() {
+      throw new AssertionError("invariant broken: " + INTERNAL_SECRET);
+    }
+  }
+}
diff --git a/src/test/java/com/example/shortener/domain/MigrationScriptTest.java b/src/test/java/com/example/shortener/domain/MigrationScriptTest.java
new file mode 100644
index 0000000..4fee472
--- /dev/null
+++ b/src/test/java/com/example/shortener/domain/MigrationScriptTest.java
@@ -0,0 +1,132 @@
+package com.example.shortener.domain;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.io.IOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Locale;
+import java.util.regex.Pattern;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.springframework.data.jpa.repository.Query;
+
+/**
+ * AC-1 / AC-11 / AC-15: the Flyway migration creating the {@code urls} table and the fallback
+ * sequence exists and declares every column and object the entity and repository rely on. Runs
+ * against the SQL text only; no database or container is needed.
+ */
+class MigrationScriptTest {
+
+  private static final Path MIGRATIONS = Path.of("src/main/resources/db/migration");
+  private static final Path V1 = MIGRATIONS.resolve("V1__create_urls_table.sql");
+
+  /** AMB-11 seed offset (62^5): the sequence must start strictly after it. */
+  private static final long SEED_OFFSET = 916_132_832L;
+
+  private static String sql;
+
+  @BeforeAll
+  static void readMigration() throws IOException {
+    assertThat(V1).as("migration file").isRegularFile();
+    sql = Files.readString(V1);
+  }
+
+  private static String normalised() {
+    return sql.replaceAll("\\s+", " ").toLowerCase(Locale.ROOT);
+  }
+
+  @Test
+  void ac1_migrationIsTheFirstFlywayVersion() throws IOException {
+    assertThat(V1.getFileName().toString()).matches("V1__[A-Za-z0-9_]+\\.sql");
+
+    try (Stream<Path> files = Files.list(MIGRATIONS)) {
+      List<String> names = files.map(p -> p.getFileName().toString()).sorted().toList();
+      assertThat(names).contains("V1__create_urls_table.sql");
+      assertThat(names).allMatch(n -> n.matches("V\\d+(_\\d+)*__[A-Za-z0-9_]+\\.sql"));
+      assertThat(names.stream().filter(n -> n.startsWith("V1__")).count())
+          .as("exactly one V1 migration")
+          .isEqualTo(1);
+    }
+  }
+
+  @Test
+  void ac1_createsUrlsTableWithShortCodePrimaryKey() {
+    String n = normalised();
+
+    assertThat(n).contains("create table urls");
+    assertThat(n).containsPattern("primary key \\(\\s*short_code\\s*\\)");
+    assertThat(n).containsPattern("short_code\\s+varchar\\(32\\)\\s+not null");
+  }
+
+  @Test
+  void ac1_declaresEveryColumnOfTheDataModelSlice() {
+    String n = normalised();
+
+    assertThat(n).containsPattern("long_url\\s+varchar\\(2048\\)\\s+not null");
+    assertThat(n).containsPattern("created_at\\s+timestamptz\\s+not null");
+    assertThat(n).containsPattern("expires_at\\s+timestamptz\\s+null");
+    assertThat(n).containsPattern("created_by\\s+varchar(\\(\\d+\\))?\\s+null");
+    assertThat(n).containsPattern("code_source\\s+varchar(\\(\\d+\\))?\\s+not null");
+  }
+
+  @Test
+  void ac15_codeSourceIsConstrainedToTheEnumDbValues() {
+    String n = normalised();
+
+    assertThat(n).containsPattern("check \\(\\s*code_source in \\(");
+    for (CodeSource source : CodeSource.values()) {
+      assertThat(n).contains("'" + source.dbValue() + "'");
+    }
+  }
+
+  @Test
+  void ac11_createsIndexSupportingExpiryLookups() {
+    String n = normalised();
+
+    assertThat(n).containsPattern("create index \\w+ on urls \\(\\s*expires_at\\s*\\)");
+  }
+
+  @Test
+  void ac15_createsFallbackSequenceSeededPastTheSeedOffset() {
+    String n = normalised();
+    var m = Pattern.compile("create sequence url_code_seq.*?start with (\\d+)").matcher(n);
+
+    assertThat(m.find()).as("CREATE SEQUENCE url_code_seq ... START WITH <n>").isTrue();
+    assertThat(Long.parseLong(m.group(1))).isGreaterThan(SEED_OFFSET);
+    assertThat(n).contains("create sequence url_code_seq");
+  }
+
+  @Test
+  void ac15_repositoryNextvalTargetsTheMigratedSequence() throws NoSuchMethodException {
+    Method next = UrlMappingRepository.class.getMethod("nextCodeSequenceValue");
+    Query query = next.getAnnotation(Query.class);
+
+    assertThat(query).isNotNull();
+    assertThat(query.nativeQuery()).isTrue();
+    assertThat(query.value().toLowerCase(Locale.ROOT))
+        .contains("nextval('" + UrlMappingRepository.CODE_SEQUENCE_NAME + "')");
+    assertThat(normalised()).contains("create sequence " + UrlMappingRepository.CODE_SEQUENCE_NAME);
+  }
+
+  @Test
+  void ac1_repositoryExposesLookupsByShortCode() throws NoSuchMethodException {
+    assertThat(
+            UrlMappingRepository.class.getMethod("existsByShortCode", String.class).getReturnType())
+        .isEqualTo(boolean.class);
+    assertThat(
+            UrlMappingRepository.class.getMethod("findByShortCode", String.class).getReturnType())
+        .isEqualTo(java.util.Optional.class);
+  }
+
+  @Test
+  void ac1_migrationHasNoSecretsOrUnsafeStatements() {
+    String n = normalised();
+
+    assertThat(n).doesNotContain("drop table");
+    assertThat(n).doesNotContain("password");
+  }
+}
diff --git a/src/test/java/com/example/shortener/domain/UrlMappingTest.java b/src/test/java/com/example/shortener/domain/UrlMappingTest.java
new file mode 100644
index 0000000..191c2d3
--- /dev/null
+++ b/src/test/java/com/example/shortener/domain/UrlMappingTest.java
@@ -0,0 +1,178 @@
+package com.example.shortener.domain;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.lang.reflect.Field;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.Arrays;
+import java.util.Map;
+import java.util.stream.Collectors;
+import org.junit.jupiter.api.Test;
+
+/**
+ * AC-1 / AC-11 / AC-15: entity expiry logic, code-source persistence values and the 1:1 column
+ * mapping, all without a database.
+ */
+class UrlMappingTest {
+
+  private static final Instant CREATED = Instant.parse("2026-09-13T10:00:00Z");
+  private static final Instant EXPIRES = Instant.parse("2026-09-14T10:00:00Z");
+
+  private static UrlMapping mapping(Instant expiresAt) {
+    return new UrlMapping(
+        "abc123", "https://example.com/very/long", CREATED, expiresAt, CodeSource.REDIS);
+  }
+
+  // --- AC-11: expiry -------------------------------------------------------------------------
+
+  @Test
+  void ac11_notExpiredBeforeExpiresAt() {
+    UrlMapping m = mapping(EXPIRES);
+
+    assertThat(m.isExpired(EXPIRES.minusMillis(1))).isFalse();
+    assertThat(m.isExpired(CREATED)).isFalse();
+    assertThat(m.hasExpiry()).isTrue();
+  }
+
+  @Test
+  void ac11_expiredExactlyAtExpiresAt() {
+    UrlMapping m = mapping(EXPIRES);
+
+    assertThat(m.isExpired(EXPIRES)).isTrue();
+  }
+
+  @Test
+  void ac11_expiredAfterExpiresAt() {
+    UrlMapping m = mapping(EXPIRES);
+
+    assertThat(m.isExpired(EXPIRES.plusMillis(1))).isTrue();
+    assertThat(m.isExpired(EXPIRES.plus(Duration.ofDays(365)))).isTrue();
+  }
+
+  @Test
+  void ac11_neverExpiresWithoutExpiresAt() {
+    UrlMapping m = mapping(null);
+
+    assertThat(m.hasExpiry()).isFalse();
+    assertThat(m.getExpiresAt()).isNull();
+    assertThat(m.isExpired(CREATED)).isFalse();
+    assertThat(m.isExpired(Instant.MAX)).isFalse();
+  }
+
+  @Test
+  void ac11_isExpiredRejectsNullNow() {
+    assertThatThrownBy(() -> mapping(EXPIRES).isExpired(null))
+        .isInstanceOf(NullPointerException.class);
+  }
+
+  // --- AC-1: creation state --------------------------------------------------------------------
+
+  @Test
+  void ac1_constructorStoresAllColumnsAndCreatedByIsNull() {
+    UrlMapping m =
+        new UrlMapping("k7Yx2A", "https://example.com/a", CREATED, EXPIRES, CodeSource.DB_SEQUENCE);
+
+    assertThat(m.getShortCode()).isEqualTo("k7Yx2A");
+    assertThat(m.getLongUrl()).isEqualTo("https://example.com/a");
+    assertThat(m.getCreatedAt()).isEqualTo(CREATED);
+    assertThat(m.getExpiresAt()).isEqualTo(EXPIRES);
+    assertThat(m.getCodeSource()).isEqualTo(CodeSource.DB_SEQUENCE);
+    assertThat(m.getCreatedBy()).isNull();
+  }
+
+  @Test
+  void ac1_requiredFieldsAreMandatory() {
+    assertThatThrownBy(() -> new UrlMapping(null, "https://e.com", CREATED, null, CodeSource.REDIS))
+        .isInstanceOf(NullPointerException.class);
+    assertThatThrownBy(() -> new UrlMapping("abc", null, CREATED, null, CodeSource.REDIS))
+        .isInstanceOf(NullPointerException.class);
+    assertThatThrownBy(() -> new UrlMapping("abc", "https://e.com", null, null, CodeSource.REDIS))
+        .isInstanceOf(NullPointerException.class);
+    assertThatThrownBy(() -> new UrlMapping("abc", "https://e.com", CREATED, null, null))
+        .isInstanceOf(NullPointerException.class);
+  }
+
+  @Test
+  void ac1_identityIsTheShortCode() {
+    UrlMapping a = new UrlMapping("same", "https://a.com", CREATED, null, CodeSource.REDIS);
+    UrlMapping b =
+        new UrlMapping("same", "https://b.com", EXPIRES, EXPIRES, CodeSource.DB_SEQUENCE);
+    UrlMapping c = new UrlMapping("other", "https://a.com", CREATED, null, CodeSource.REDIS);
+
+    assertThat(a).isEqualTo(b).hasSameHashCodeAs(b).isNotEqualTo(c);
+    assertThat(a.toString()).contains("same").doesNotContain("https://a.com");
+  }
+
+  // --- AC-15: code source persisted as 'redis' | 'db_sequence' --------------------------------
+
+  @Test
+  void ac15_codeSourceDbValues() {
+    assertThat(CodeSource.REDIS.dbValue()).isEqualTo("redis");
+    assertThat(CodeSource.DB_SEQUENCE.dbValue()).isEqualTo("db_sequence");
+    assertThat(CodeSource.values()).containsExactly(CodeSource.REDIS, CodeSource.DB_SEQUENCE);
+  }
+
+  @Test
+  void ac15_codeSourceRoundTripsThroughDbValue() {
+    for (CodeSource source : CodeSource.values()) {
+      assertThat(CodeSource.fromDbValue(source.dbValue())).isSameAs(source);
+    }
+    assertThatThrownBy(() -> CodeSource.fromDbValue("REDIS"))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> CodeSource.fromDbValue("sequence"))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+
+  @Test
+  void ac15_jpaConverterStoresDbValueNotNameOrOrdinal() {
+    CodeSource.JpaConverter converter = new CodeSource.JpaConverter();
+
+    assertThat(converter.convertToDatabaseColumn(CodeSource.REDIS)).isEqualTo("redis");
+    assertThat(converter.convertToDatabaseColumn(CodeSource.DB_SEQUENCE)).isEqualTo("db_sequence");
+    assertThat(converter.convertToDatabaseColumn(null)).isNull();
+    assertThat(converter.convertToEntityAttribute("redis")).isEqualTo(CodeSource.REDIS);
+    assertThat(converter.convertToEntityAttribute("db_sequence")).isEqualTo(CodeSource.DB_SEQUENCE);
+    assertThat(converter.convertToEntityAttribute(null)).isNull();
+  }
+
+  // --- AC-1: JPA mapping is 1:1 with the migration columns ------------------------------------
+
+  @Test
+  void ac1_entityIsMappedToUrlsTableWithShortCodeAsId() throws NoSuchFieldException {
+    assertThat(UrlMapping.class.isAnnotationPresent(Entity.class)).isTrue();
+    assertThat(UrlMapping.class.getAnnotation(Table.class).name()).isEqualTo("urls");
+
+    Field id = UrlMapping.class.getDeclaredField("shortCode");
+    assertThat(id.isAnnotationPresent(Id.class)).isTrue();
+    assertThat(id.getAnnotation(Column.class).name()).isEqualTo("short_code");
+    assertThat(id.getAnnotation(Column.class).length()).isEqualTo(32);
+  }
+
+  @Test
+  void ac1_columnNamesMatchTheMigration() {
+    Map<String, Column> columns =
+        Arrays.stream(UrlMapping.class.getDeclaredFields())
+            .filter(f -> f.isAnnotationPresent(Column.class))
+            .collect(Collectors.toMap(Field::getName, f -> f.getAnnotation(Column.class)));
+
+    assertThat(columns.keySet())
+        .containsExactlyInAnyOrder(
+            "shortCode", "longUrl", "createdAt", "expiresAt", "createdBy", "codeSource");
+    assertThat(columns.values().stream().map(Column::name))
+        .containsExactlyInAnyOrder(
+            "short_code", "long_url", "created_at", "expires_at", "created_by", "code_source");
+
+    assertThat(columns.get("longUrl").length()).isEqualTo(2048);
+    assertThat(columns.get("longUrl").nullable()).isFalse();
+    assertThat(columns.get("createdAt").nullable()).isFalse();
+    assertThat(columns.get("codeSource").nullable()).isFalse();
+    assertThat(columns.get("expiresAt").nullable()).isTrue();
+    assertThat(columns.get("createdBy").nullable()).isTrue();
+  }
+}
