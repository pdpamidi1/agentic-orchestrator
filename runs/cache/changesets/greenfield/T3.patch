@@ -0,0 +1,17 @@
+package com.example.shortener.api.error;
+
+/**
+ * Thrown for semantic URL or expiry rejections detected outside Bean Validation (for example a URL
+ * that matches the syntactic pattern but cannot be used). Rendered as {@code 400 Bad Request} by
+ * {@link GlobalExceptionHandler}; the message becomes the problem {@code detail}, so it must be
+ * safe to show to the caller.
+ */
+public class InvalidUrlException extends RuntimeException {
+
+  /**
+   * @param message caller-facing reason for the rejection
+   */
+  public InvalidUrlException(String message) {
+    super(message);
+  }
+}
