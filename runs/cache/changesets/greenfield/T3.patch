@@ -0,0 +1,23 @@
+package com.example.shortener.api.error;
+
+/**
+ * Thrown when a custom alias or generated short code is already present in the {@code urls} table.
+ * Rendered as {@code 409 Conflict} by {@link GlobalExceptionHandler}.
+ */
+public class AliasAlreadyExistsException extends RuntimeException {
+
+  private final String shortCode;
+
+  /**
+   * @param shortCode the alias / short code that is already taken
+   */
+  public AliasAlreadyExistsException(String shortCode) {
+    super("Short code '" + shortCode + "' is already taken");
+    this.shortCode = shortCode;
+  }
+
+  /** The alias / short code that is already taken. */
+  public String getShortCode() {
+    return shortCode;
+  }
+}
diff --git a/src/main/java/com/example/shortener/api/error/GlobalExceptionHandler.java b/src/main/java/com/example/shortener/api/error/GlobalExceptionHandler.java
new file mode 100644
index 0000000..4926454
--- /dev/null
+++ b/src/main/java/com/example/shortener/api/error/GlobalExceptionHandler.java
@@ -0,0 +1,252 @@
+package com.example.shortener.api.error;
+
+import java.net.URI;
+import java.util.Comparator;
+import java.util.stream.Collectors;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.HttpStatusCode;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+import org.springframework.http.converter.HttpMessageNotReadableException;
+import org.springframework.validation.FieldError;
+import org.springframework.web.bind.MethodArgumentNotValidException;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.RestControllerAdvice;
+import org.springframework.web.context.request.ServletWebRequest;
+import org.springframework.web.context.request.WebRequest;
+import org.springframework.web.servlet.mvc.method.annotation.ResponseEntityExceptionHandler;
+
+/**
+ * Single source of every non-2xx response body (AC-16, ADR-008).
+ *
+ * <p>Every error is rendered as an RFC 9457 {@link ProblemDetail} with Content-Type {@code
+ * application/problem+json} and the fields {@code type}, {@code title}, {@code status}, {@code
+ * detail} and {@code instance}. {@code type} is a stable URN of the form {@code
+ * urn:shortener:problem:<slug>}; {@code instance} is the request path. No stack trace, exception
+ * class name, SQL, connection string or other internal identifier is ever written to the body;
+ * unhandled errors are logged server-side with their stack trace and answered with a generic {@code
+ * 500} problem.
+ *
+ * <ul>
+ *   <li>{@code 400}: Bean Validation failures on the request body, unreadable / malformed JSON
+ *       (including malformed ISO-8601 dates) and {@link InvalidUrlException}
+ *   <li>{@code 404}: {@link ShortCodeNotFoundException}
+ *   <li>{@code 409}: {@link AliasAlreadyExistsException}
+ *   <li>{@code 410}: {@link ShortCodeExpiredException}
+ *   <li>{@code 500}: any other {@link Throwable}
+ * </ul>
+ *
+ * <p>Framework exceptions handled by {@link ResponseEntityExceptionHandler} (405, 406, 415, ...)
+ * keep Spring's default title/detail but are normalised to the same {@code type} scheme.
+ */
+@RestControllerAdvice
+public class GlobalExceptionHandler extends ResponseEntityExceptionHandler {
+
+  private static final Logger log = LoggerFactory.getLogger(GlobalExceptionHandler.class);
+
+  /** Prefix of every problem {@code type} URN emitted by this handler. */
+  public static final String TYPE_PREFIX = "urn:shortener:problem:";
+
+  public static final URI TYPE_VALIDATION_ERROR = type("validation-error");
+  public static final URI TYPE_MALFORMED_BODY = type("malformed-request-body");
+  public static final URI TYPE_INVALID_URL = type("invalid-url");
+  public static final URI TYPE_NOT_FOUND = type("short-code-not-found");
+  public static final URI TYPE_ALIAS_CONFLICT = type("alias-already-exists");
+  public static final URI TYPE_EXPIRED = type("short-code-expired");
+  public static final URI TYPE_INTERNAL_ERROR = type("internal-error");
+
+  static final String TITLE_VALIDATION_ERROR = "Validation failed";
+  static final String TITLE_MALFORMED_BODY = "Malformed request body";
+  static final String TITLE_INVALID_URL = "Invalid URL";
+  static final String TITLE_NOT_FOUND = "Short code not found";
+  static final String TITLE_ALIAS_CONFLICT = "Alias already exists";
+  static final String TITLE_EXPIRED = "Short code expired";
+  static final String TITLE_INTERNAL_ERROR = "Internal server error";
+
+  static final String DETAIL_MALFORMED_BODY =
+      "The request body could not be read. It must be a JSON object matching the documented"
+          + " schema; date-time fields use ISO-8601 with an offset, e.g. 2030-01-01T00:00:00Z.";
+  static final String DETAIL_INTERNAL_ERROR =
+      "An unexpected error occurred while processing the request.";
+
+  // ---------------------------------------------------------------------------------------------
+  // 400
+  // ---------------------------------------------------------------------------------------------
+
+  /** Bean Validation failures on a {@code @Valid @RequestBody}: one line per rejected field. */
+  @Override
+  protected ResponseEntity<Object> handleMethodArgumentNotValid(
+      MethodArgumentNotValidException ex,
+      HttpHeaders headers,
+      HttpStatusCode status,
+      WebRequest request) {
+    String detail =
+        ex.getBindingResult().getFieldErrors().stream()
+            .sorted(
+                Comparator.comparing(FieldError::getField)
+                    .thenComparing(
+                        FieldError::getDefaultMessage,
+                        Comparator.nullsLast(Comparator.naturalOrder())))
+            .map(fe -> toSnakeCase(fe.getField()) + ": " + safeMessage(fe))
+            .collect(Collectors.joining("; "));
+    if (detail.isBlank()) {
+      detail = "The request body failed validation.";
+    }
+    ProblemDetail body =
+        problem(HttpStatus.BAD_REQUEST, TYPE_VALIDATION_ERROR, TITLE_VALIDATION_ERROR, detail);
+    return handleExceptionInternal(ex, body, headers, HttpStatus.BAD_REQUEST, request);
+  }
+
+  /**
+   * Unreadable body: invalid JSON, wrong JSON type, or a value such as a malformed ISO-8601 {@code
+   * expiration_date} that cannot be converted. The parser message is never echoed.
+   */
+  @Override
+  protected ResponseEntity<Object> handleHttpMessageNotReadable(
+      HttpMessageNotReadableException ex,
+      HttpHeaders headers,
+      HttpStatusCode status,
+      WebRequest request) {
+    ProblemDetail body =
+        problem(
+            HttpStatus.BAD_REQUEST,
+            TYPE_MALFORMED_BODY,
+            TITLE_MALFORMED_BODY,
+            DETAIL_MALFORMED_BODY);
+    return handleExceptionInternal(ex, body, headers, HttpStatus.BAD_REQUEST, request);
+  }
+
+  /** Semantic URL / expiry rejection raised by a service. */
+  @ExceptionHandler(InvalidUrlException.class)
+  public ResponseEntity<Object> handleInvalidUrl(InvalidUrlException ex, WebRequest request) {
+    return respond(
+        problem(HttpStatus.BAD_REQUEST, TYPE_INVALID_URL, TITLE_INVALID_URL, ex.getMessage()),
+        request);
+  }
+
+  // ---------------------------------------------------------------------------------------------
+  // 404 / 409 / 410
+  // ---------------------------------------------------------------------------------------------
+
+  @ExceptionHandler(ShortCodeNotFoundException.class)
+  public ResponseEntity<Object> handleShortCodeNotFound(
+      ShortCodeNotFoundException ex, WebRequest request) {
+    return respond(
+        problem(HttpStatus.NOT_FOUND, TYPE_NOT_FOUND, TITLE_NOT_FOUND, ex.getMessage()), request);
+  }
+
+  @ExceptionHandler(AliasAlreadyExistsException.class)
+  public ResponseEntity<Object> handleAliasAlreadyExists(
+      AliasAlreadyExistsException ex, WebRequest request) {
+    return respond(
+        problem(HttpStatus.CONFLICT, TYPE_ALIAS_CONFLICT, TITLE_ALIAS_CONFLICT, ex.getMessage()),
+        request);
+  }
+
+  @ExceptionHandler(ShortCodeExpiredException.class)
+  public ResponseEntity<Object> handleShortCodeExpired(
+      ShortCodeExpiredException ex, WebRequest request) {
+    return respond(problem(HttpStatus.GONE, TYPE_EXPIRED, TITLE_EXPIRED, ex.getMessage()), request);
+  }
+
+  // ---------------------------------------------------------------------------------------------
+  // 500
+  // ---------------------------------------------------------------------------------------------
+
+  /**
+   * Last resort: anything not mapped above. The throwable is logged with its stack trace; the
+   * client receives a fixed, generic problem.
+   */
+  @ExceptionHandler(Throwable.class)
+  public ResponseEntity<Object> handleUnexpected(Throwable ex, WebRequest request) {
+    log.error("Unhandled error while processing {}", request.getDescription(false), ex);
+    return respond(
+        problem(
+            HttpStatus.INTERNAL_SERVER_ERROR,
+            TYPE_INTERNAL_ERROR,
+            TITLE_INTERNAL_ERROR,
+            DETAIL_INTERNAL_ERROR),
+        request);
+  }
+
+  // ---------------------------------------------------------------------------------------------
+  // Normalisation of everything that leaves this handler
+  // ---------------------------------------------------------------------------------------------
+
+  /**
+   * Applied to every response produced by the base class as well: guarantees {@code instance} is
+   * the request path and {@code type} is never the RFC default {@code about:blank}.
+   */
+  @Override
+  protected ResponseEntity<Object> createResponseEntity(
+      Object body, HttpHeaders headers, HttpStatusCode statusCode, WebRequest request) {
+    if (body instanceof ProblemDetail problem) {
+      normalise(problem, request);
+    }
+    return super.createResponseEntity(body, headers, statusCode, request);
+  }
+
+  private ResponseEntity<Object> respond(ProblemDetail problem, WebRequest request) {
+    normalise(problem, request);
+    return ResponseEntity.status(problem.getStatus()).body(problem);
+  }
+
+  private static void normalise(ProblemDetail problem, WebRequest request) {
+    if (problem.getInstance() == null) {
+      problem.setInstance(instanceOf(request));
+    }
+    if (problem.getType() == null || "about:blank".equals(problem.getType().toString())) {
+      HttpStatus status = HttpStatus.resolve(problem.getStatus());
+      String slug =
+          status == null
+              ? "http-" + problem.getStatus()
+              : status.name().toLowerCase().replace('_', '-');
+      problem.setType(type(slug));
+    }
+  }
+
+  private static ProblemDetail problem(HttpStatus status, URI type, String title, String detail) {
+    ProblemDetail problem = ProblemDetail.forStatusAndDetail(status, detail);
+    problem.setType(type);
+    problem.setTitle(title);
+    return problem;
+  }
+
+  private static URI instanceOf(WebRequest request) {
+    if (request instanceof ServletWebRequest servletRequest) {
+      try {
+        return URI.create(servletRequest.getRequest().getRequestURI());
+      } catch (IllegalArgumentException ignored) {
+        // Fall through: an unparseable path is simply not reported as instance.
+      }
+    }
+    return null;
+  }
+
+  private static URI type(String slug) {
+    return URI.create(TYPE_PREFIX + slug);
+  }
+
+  /** Constraint messages are authored in the DTO and safe to return; never expose anything else. */
+  private static String safeMessage(FieldError error) {
+    String message = error.getDefaultMessage();
+    return message == null || message.isBlank() ? "is invalid" : message;
+  }
+
+  /** Maps a Java property name ({@code longUrl}) to its JSON name ({@code long_url}). */
+  static String toSnakeCase(String property) {
+    StringBuilder out = new StringBuilder(property.length() + 4);
+    for (int i = 0; i < property.length(); i++) {
+      char c = property.charAt(i);
+      if (Character.isUpperCase(c)) {
+        out.append('_').append(Character.toLowerCase(c));
+      } else {
+        out.append(c);
+      }
+    }
+    return out.toString();
+  }
+}
