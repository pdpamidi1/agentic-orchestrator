--- /dev/null
+++ b/src/main/java/com/example/shortener/api/dto/CreateUrlRequest.java
@@ -0,0 +1,41 @@
+package com.example.shortener.api.dto;
+
+import com.fasterxml.jackson.annotation.JsonProperty;
+import jakarta.validation.constraints.Future;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.Pattern;
+import jakarta.validation.constraints.Size;
+import java.time.OffsetDateTime;
+
+/**
+ * Body of {@code POST /api/v1/urls} ({@code createShortUrl}), serialised with snake_case names.
+ *
+ * <p>Bean Validation encodes the contract of the {@code CreateUrlRequest} schema (AC-2, AC-5,
+ * AC-6). A malformed {@code expiration_date} never reaches validation: Jackson rejects it while
+ * reading the body, which {@code GlobalExceptionHandler} renders as a 400 problem.
+ *
+ * @param longUrl absolute http or https URL, at most {@value #LONG_URL_MAX_LENGTH} characters
+ * @param customAlias optional caller-chosen short code matching {@value #ALIAS_PATTERN}
+ * @param expirationDate optional ISO-8601 instant that must lie in the future
+ */
+public record CreateUrlRequest(
+    @JsonProperty("long_url")
+        @NotBlank(message = "must not be blank")
+        @Size(max = LONG_URL_MAX_LENGTH, message = "must be at most {max} characters")
+        @Pattern(regexp = LONG_URL_PATTERN, message = "must be an absolute http or https URL")
+        String longUrl,
+    @JsonProperty("custom_alias")
+        @Pattern(regexp = ALIAS_PATTERN, message = "must be 3 to 32 characters from [0-9a-zA-Z]")
+        String customAlias,
+    @JsonProperty("expiration_date") @Future(message = "must be in the future")
+        OffsetDateTime expirationDate) {
+
+  /** Maximum length of {@code long_url}; matches {@code urls_long_url_len_chk}. */
+  public static final int LONG_URL_MAX_LENGTH = 2048;
+
+  /** {@code long_url} must be an absolute http or https URL (AC-2). */
+  public static final String LONG_URL_PATTERN = "^https?://\\S+$";
+
+  /** {@code custom_alias} charset and length (AC-5); matches {@code urls_short_code_format_chk}. */
+  public static final String ALIAS_PATTERN = "^[0-9a-zA-Z]{3,32}$";
+}
