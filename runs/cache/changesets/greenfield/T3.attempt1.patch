@@ -0,0 +1,21 @@
+package com.example.shortener.api.error;
+
+import java.util.Objects;
+
+/**
+ * Thrown for semantic URL or expiry rejections detected outside Bean Validation (for example a
+ * syntactically valid-looking {@code long_url} that cannot be parsed as a URI); rendered as 400 by
+ * {@link GlobalExceptionHandler} (AC-2, AC-6).
+ *
+ * <p>The message becomes the problem {@code detail}, so it must be safe to show to a client: no
+ * stack traces, internal identifiers or secrets.
+ */
+public class InvalidUrlException extends RuntimeException {
+
+  /**
+   * @param detail client-safe description of why the value was rejected
+   */
+  public InvalidUrlException(String detail) {
+    super(Objects.requireNonNull(detail, "detail"));
+  }
+}
