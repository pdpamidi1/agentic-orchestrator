@@ -0,0 +1,25 @@
+package com.example.shortener.api.error;
+
+import java.util.Objects;
+
+/**
+ * Thrown when a short code exists in neither the cache nor the database; rendered as 404 by {@link
+ * GlobalExceptionHandler} (AC-8).
+ */
+public class ShortCodeNotFoundException extends RuntimeException {
+
+  private final String shortCode;
+
+  /**
+   * @param shortCode the unknown short code
+   */
+  public ShortCodeNotFoundException(String shortCode) {
+    super("Short code '" + Objects.requireNonNull(shortCode, "shortCode") + "' was not found");
+    this.shortCode = shortCode;
+  }
+
+  /** The short code that could not be resolved. */
+  public String getShortCode() {
+    return shortCode;
+  }
+}
diff --git a/src/test/java/com/example/shortener/api/dto/CreateUrlRequestValidationTest.java b/src/test/java/com/example/shortener/api/dto/CreateUrlRequestValidationTest.java
new file mode 100644
index 0000000..21143c8
--- /dev/null
+++ b/src/test/java/com/example/shortener/api/dto/CreateUrlRequestValidationTest.java
@@ -0,0 +1,219 @@
+package com.example.shortener.api.dto;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import jakarta.validation.ConstraintViolation;
+import jakarta.validation.Validation;
+import jakarta.validation.Validator;
+import jakarta.validation.ValidatorFactory;
+import java.time.OffsetDateTime;
+import java.time.ZoneOffset;
+import java.util.Set;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import tools.jackson.core.JacksonException;
+import tools.jackson.databind.json.JsonMapper;
+
+/**
+ * Bean Validation and JSON binding rules of {@link CreateUrlRequest} / {@link CreateUrlResponse}
+ * (AC-2, AC-5, AC-6); no Spring context.
+ */
+class CreateUrlRequestValidationTest {
+
+  private static final OffsetDateTime FUTURE = OffsetDateTime.now(ZoneOffset.UTC).plusDays(30);
+  private static final OffsetDateTime PAST = OffsetDateTime.now(ZoneOffset.UTC).minusMinutes(1);
+
+  private static ValidatorFactory factory;
+  private static Validator validator;
+  private static final JsonMapper json = JsonMapper.builder().build();
+
+  @BeforeAll
+  static void createValidator() {
+    factory = Validation.buildDefaultValidatorFactory();
+    validator = factory.getValidator();
+  }
+
+  @AfterAll
+  static void closeValidator() {
+    factory.close();
+  }
+
+  private static Set<ConstraintViolation<CreateUrlRequest>> validate(CreateUrlRequest request) {
+    return validator.validate(request);
+  }
+
+  private static Set<String> violatedFields(CreateUrlRequest request) {
+    return validate(request).stream()
+        .map(v -> v.getPropertyPath().toString())
+        .collect(java.util.stream.Collectors.toSet());
+  }
+
+  // --- valid input ---
+
+  @Test
+  void fullValidRequestHasNoViolations() {
+    CreateUrlRequest request =
+        new CreateUrlRequest("https://example.com/some/path?q=1", "promo2024", FUTURE);
+
+    assertThat(validate(request)).isEmpty();
+  }
+
+  @Test
+  void optionalFieldsMayBeNull() {
+    assertThat(validate(new CreateUrlRequest("http://example.com", null, null))).isEmpty();
+  }
+
+  @Test
+  void longUrlOfExactlyMaxLengthIsAccepted() {
+    String url = "https://example.com/" + "a".repeat(CreateUrlRequest.LONG_URL_MAX_LENGTH - 20);
+    assertThat(url).hasSize(2048);
+
+    assertThat(validate(new CreateUrlRequest(url, null, null))).isEmpty();
+  }
+
+  // --- long_url (AC-2) ---
+
+  @Test
+  void ftpSchemeIsRejected() {
+    assertThat(violatedFields(new CreateUrlRequest("ftp://example.com/file", null, null)))
+        .containsExactly("longUrl");
+  }
+
+  @Test
+  void otherNonHttpSchemesAndRelativeUrlsAreRejected() {
+    for (String bad :
+        new String[] {"javascript:alert(1)", "mailto:a@b.c", "example.com", "//example.com"}) {
+      assertThat(violatedFields(new CreateUrlRequest(bad, null, null)))
+          .as(bad)
+          .containsExactly("longUrl");
+    }
+  }
+
+  @Test
+  void blankAndNullLongUrlAreRejected() {
+    assertThat(violatedFields(new CreateUrlRequest(null, null, null))).containsExactly("longUrl");
+    assertThat(violatedFields(new CreateUrlRequest("", null, null))).containsExactly("longUrl");
+    assertThat(violatedFields(new CreateUrlRequest("   ", null, null))).containsExactly("longUrl");
+  }
+
+  @Test
+  void longUrlOverMaxLengthIsRejected() {
+    String url = "https://example.com/" + "a".repeat(CreateUrlRequest.LONG_URL_MAX_LENGTH - 19);
+    assertThat(url).hasSize(2049);
+
+    Set<ConstraintViolation<CreateUrlRequest>> violations =
+        validate(new CreateUrlRequest(url, null, null));
+
+    assertThat(violations).hasSize(1);
+    assertThat(violations.iterator().next().getMessage()).contains("2048");
+  }
+
+  // --- custom_alias (AC-5) ---
+
+  @Test
+  void aliasWithCharactersOutsideAlphanumericIsRejected() {
+    for (String bad : new String[] {"promo-2024", "promo_2024", "prömo", "pro mo", "a/b/c"}) {
+      assertThat(violatedFields(new CreateUrlRequest("https://example.com", bad, null)))
+          .as(bad)
+          .containsExactly("customAlias");
+    }
+  }
+
+  @Test
+  void aliasOfLengthTwoIsRejected() {
+    assertThat(violatedFields(new CreateUrlRequest("https://example.com", "ab", null)))
+        .containsExactly("customAlias");
+  }
+
+  @Test
+  void aliasOfLengthThirtyThreeIsRejected() {
+    assertThat(violatedFields(new CreateUrlRequest("https://example.com", "a".repeat(33), null)))
+        .containsExactly("customAlias");
+  }
+
+  @Test
+  void aliasBoundaryLengthsAreAccepted() {
+    assertThat(validate(new CreateUrlRequest("https://example.com", "abc", null))).isEmpty();
+    assertThat(validate(new CreateUrlRequest("https://example.com", "Z9".repeat(16), null)))
+        .isEmpty();
+  }
+
+  // --- expiration_date (AC-6) ---
+
+  @Test
+  void pastExpirationDateIsRejected() {
+    assertThat(violatedFields(new CreateUrlRequest("https://example.com", null, PAST)))
+        .containsExactly("expirationDate");
+  }
+
+  @Test
+  void malformedExpirationDateIsRejectedWhileReadingJson() {
+    String body = "{\"long_url\":\"https://example.com\",\"expiration_date\":\"next tuesday\"}";
+
+    assertThatThrownBy(() -> json.readValue(body, CreateUrlRequest.class))
+        .isInstanceOf(JacksonException.class);
+  }
+
+  @Test
+  void dateOnlyExpirationDateIsRejectedWhileReadingJson() {
+    String body = "{\"long_url\":\"https://example.com\",\"expiration_date\":\"2030-01-01\"}";
+
+    assertThatThrownBy(() -> json.readValue(body, CreateUrlRequest.class))
+        .isInstanceOf(JacksonException.class);
+  }
+
+  @Test
+  void everyInvalidFieldIsReportedTogether() {
+    assertThat(violatedFields(new CreateUrlRequest("ftp://x", "a!", PAST)))
+        .containsExactlyInAnyOrder("longUrl", "customAlias", "expirationDate");
+  }
+
+  // --- JSON names are snake_case ---
+
+  @Test
+  void requestBindsFromSnakeCaseJson() {
+    String body =
+        "{\"long_url\":\"https://example.com/p\",\"custom_alias\":\"promo2024\","
+            + "\"expiration_date\":\"2030-01-01T00:00:00Z\"}";
+
+    CreateUrlRequest request = json.readValue(body, CreateUrlRequest.class);
+
+    assertThat(request.longUrl()).isEqualTo("https://example.com/p");
+    assertThat(request.customAlias()).isEqualTo("promo2024");
+    assertThat(request.expirationDate().toInstant())
+        .isEqualTo(OffsetDateTime.parse("2030-01-01T00:00:00Z").toInstant());
+    assertThat(validate(request)).isEmpty();
+  }
+
+  @Test
+  void camelCaseJsonNamesAreNotBound() {
+    CreateUrlRequest request =
+        json.readValue("{\"longUrl\":\"https://example.com/p\"}", CreateUrlRequest.class);
+
+    assertThat(request.longUrl()).isNull();
+  }
+
+  @Test
+  void responseSerialisesWithSnakeCaseNames() {
+    CreateUrlResponse response =
+        new CreateUrlResponse(
+            "http://localhost:8080/aB3x9",
+            "aB3x9",
+            "https://example.com/p",
+            OffsetDateTime.parse("2030-01-01T00:00:00Z"),
+            "redis");
+
+    String body = json.writeValueAsString(response);
+
+    assertThat(body)
+        .contains("\"short_url\":\"http://localhost:8080/aB3x9\"")
+        .contains("\"short_code\":\"aB3x9\"")
+        .contains("\"long_url\":\"https://example.com/p\"")
+        .contains("\"expires_at\":")
+        .contains("\"code_source\":\"redis\"")
+        .doesNotContain("shortUrl")
+        .doesNotContain("codeSource");
+  }
+}
diff --git a/src/test/java/com/example/shortener/api/error/GlobalExceptionHandlerTest.java b/src/test/java/com/example/shortener/api/error/GlobalExceptionHandlerTest.java
