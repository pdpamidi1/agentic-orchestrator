@@ -0,0 +1,25 @@
+package com.example.shortener.api.error;
+
+import java.util.Objects;
+
+/**
+ * Thrown when a custom alias / short code is already present in the {@code urls} table; rendered as
+ * 409 by {@link GlobalExceptionHandler}. The existing mapping is left unchanged (AC-3).
+ */
+public class AliasAlreadyExistsException extends RuntimeException {
+
+  private final String alias;
+
+  /**
+   * @param alias the alias or short code that is already taken
+   */
+  public AliasAlreadyExistsException(String alias) {
+    super("Alias '" + Objects.requireNonNull(alias, "alias") + "' already exists");
+    this.alias = alias;
+  }
+
+  /** The alias or short code that is already taken. */
+  public String getAlias() {
+    return alias;
+  }
+}
diff --git a/src/main/java/com/example/shortener/api/error/GlobalExceptionHandler.java b/src/main/java/com/example/shortener/api/error/GlobalExceptionHandler.java
new file mode 100644
index 0000000..c0d60ba
--- /dev/null
+++ b/src/main/java/com/example/shortener/api/error/GlobalExceptionHandler.java
@@ -0,0 +1,269 @@
+package com.example.shortener.api.error;
+
+import io.swagger.v3.oas.annotations.Hidden;
+import java.net.URI;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.stream.Collectors;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.context.MessageSourceResolvable;
+import org.springframework.context.i18n.LocaleContextHolder;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.HttpStatusCode;
+import org.springframework.http.MediaType;
+import org.springframework.http.ProblemDetail;
+import org.springframework.http.ResponseEntity;
+import org.springframework.http.converter.HttpMessageNotReadableException;
+import org.springframework.validation.FieldError;
+import org.springframework.web.ErrorResponse;
+import org.springframework.web.bind.MethodArgumentNotValidException;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.RestControllerAdvice;
+import org.springframework.web.context.request.ServletWebRequest;
+import org.springframework.web.context.request.WebRequest;
+import org.springframework.web.method.annotation.HandlerMethodValidationException;
+import org.springframework.web.servlet.mvc.method.annotation.ResponseEntityExceptionHandler;
+
+/**
+ * Single source of every non-2xx response (ADR-008, AC-16): renders RFC 9457 {@link ProblemDetail}
+ * bodies as {@code application/problem+json} with a consistent {@code type}, {@code title}, {@code
+ * status}, {@code detail} and {@code instance}.
+ *
+ * <ul>
+ *   <li>400: Bean Validation failures, unreadable or mistyped bodies (malformed ISO-8601 {@code
+ *       expiration_date}) and {@link InvalidUrlException}
+ *   <li>404: {@link ShortCodeNotFoundException}
+ *   <li>409: {@link AliasAlreadyExistsException}
+ *   <li>410: {@link ShortCodeExpiredException}
+ *   <li>500: anything else; the body never carries the exception class, message or stack trace
+ * </ul>
+ *
+ * <p>Exceptions Spring MVC raises itself (405, 415, ...) go through {@link
+ * ResponseEntityExceptionHandler} and are normalised in {@link #handleExceptionInternal} so they
+ * share the same body shape. Controllers never build error bodies.
+ *
+ * <p>{@code @Hidden} keeps springdoc from advertising these handlers as generic responses on every
+ * operation; the per-operation error responses are declared in the committed OpenAPI document.
+ */
+@Hidden
+@RestControllerAdvice
+public class GlobalExceptionHandler extends ResponseEntityExceptionHandler {
+
+  /** Prefix of every problem {@code type} URI; the path segment identifies the problem kind. */
+  public static final String TYPE_BASE = "https://example.com/problems/";
+
+  /** Problem kind for Bean Validation failures (AC-2, AC-5, AC-6). */
+  public static final String VALIDATION_FAILED = "validation-failed";
+
+  /** Problem kind for unreadable JSON or mistyped fields such as a malformed ISO-8601 date. */
+  public static final String MALFORMED_REQUEST = "malformed-request";
+
+  /** Problem kind for {@link InvalidUrlException}. */
+  public static final String INVALID_URL = "invalid-url";
+
+  /** Problem kind for {@link ShortCodeNotFoundException}. */
+  public static final String SHORT_CODE_NOT_FOUND = "short-code-not-found";
+
+  /** Problem kind for {@link AliasAlreadyExistsException}. */
+  public static final String ALIAS_ALREADY_EXISTS = "alias-already-exists";
+
+  /** Problem kind for {@link ShortCodeExpiredException}. */
+  public static final String SHORT_CODE_EXPIRED = "short-code-expired";
+
+  /** Problem kind for unhandled server errors. */
+  public static final String INTERNAL_ERROR = "internal-error";
+
+  private static final String INTERNAL_ERROR_DETAIL =
+      "An unexpected error occurred. Please retry later.";
+  private static final String MALFORMED_REQUEST_DETAIL =
+      "Request body is not valid JSON or a field has the wrong format"
+          + " (dates must be ISO-8601 date-times, e.g. 2030-01-01T00:00:00Z).";
+
+  private static final Logger log = LoggerFactory.getLogger(GlobalExceptionHandler.class);
+
+  /** Semantic URL / expiry rejections raised by services: 400. */
+  @ExceptionHandler(InvalidUrlException.class)
+  public ResponseEntity<ProblemDetail> handleInvalidUrl(
+      InvalidUrlException ex, WebRequest request) {
+    return respond(HttpStatus.BAD_REQUEST, INVALID_URL, "Invalid URL", ex.getMessage(), request);
+  }
+
+  /** Unknown short code: 404. */
+  @ExceptionHandler(ShortCodeNotFoundException.class)
+  public ResponseEntity<ProblemDetail> handleShortCodeNotFound(
+      ShortCodeNotFoundException ex, WebRequest request) {
+    return respond(
+        HttpStatus.NOT_FOUND,
+        SHORT_CODE_NOT_FOUND,
+        "Short code not found",
+        ex.getMessage(),
+        request);
+  }
+
+  /** Alias / short code already taken: 409. */
+  @ExceptionHandler(AliasAlreadyExistsException.class)
+  public ResponseEntity<ProblemDetail> handleAliasAlreadyExists(
+      AliasAlreadyExistsException ex, WebRequest request) {
+    return respond(
+        HttpStatus.CONFLICT,
+        ALIAS_ALREADY_EXISTS,
+        "Alias already exists",
+        ex.getMessage(),
+        request);
+  }
+
+  /** Expired mapping: 410. */
+  @ExceptionHandler(ShortCodeExpiredException.class)
+  public ResponseEntity<ProblemDetail> handleShortCodeExpired(
+      ShortCodeExpiredException ex, WebRequest request) {
+    return respond(
+        HttpStatus.GONE, SHORT_CODE_EXPIRED, "Short code expired", ex.getMessage(), request);
+  }
+
+  /** Anything not mapped above: 500 with a fixed, non-revealing detail. */
+  @ExceptionHandler(Throwable.class)
+  public ResponseEntity<ProblemDetail> handleUnexpected(Throwable ex, WebRequest request) {
+    log.error("Unhandled exception while serving {}", request.getDescription(false), ex);
+    return respond(
+        HttpStatus.INTERNAL_SERVER_ERROR,
+        INTERNAL_ERROR,
+        "Internal server error",
+        INTERNAL_ERROR_DETAIL,
+        request);
+  }
+
+  /** Bean Validation failure of a {@code @Valid @RequestBody}: 400 listing every field error. */
+  @Override
+  protected ResponseEntity<Object> handleMethodArgumentNotValid(
+      MethodArgumentNotValidException ex,
+      HttpHeaders headers,
+      HttpStatusCode status,
+      WebRequest request) {
+    String detail =
+        ex.getBindingResult().getFieldErrors().stream()
+            .map(GlobalExceptionHandler::describe)
+            .sorted()
+            .collect(Collectors.joining("; "));
+    ProblemDetail problem =
+        problem(HttpStatus.BAD_REQUEST, VALIDATION_FAILED, "Validation failed", detail, request);
+    return handleExceptionInternal(ex, problem, headers, HttpStatus.BAD_REQUEST, request);
+  }
+
+  /** Constraint violations on handler method parameters (path variables, params): 400. */
+  @Override
+  protected ResponseEntity<Object> handleHandlerMethodValidationException(
+      HandlerMethodValidationException ex,
+      HttpHeaders headers,
+      HttpStatusCode status,
+      WebRequest request) {
+    String detail =
+        ex.getAllErrors().stream()
+            .map(MessageSourceResolvable::getDefaultMessage)
+            .filter(Objects::nonNull)
+            .sorted()
+            .collect(Collectors.joining("; "));
+    ProblemDetail problem =
+        problem(HttpStatus.BAD_REQUEST, VALIDATION_FAILED, "Validation failed", detail, request);
+    return handleExceptionInternal(ex, problem, headers, HttpStatus.BAD_REQUEST, request);
+  }
+
+  /** Unreadable JSON or a value of the wrong type (e.g. malformed {@code expiration_date}): 400. */
+  @Override
+  protected ResponseEntity<Object> handleHttpMessageNotReadable(
+      HttpMessageNotReadableException ex,
+      HttpHeaders headers,
+      HttpStatusCode status,
+      WebRequest request) {
+    ProblemDetail problem =
+        problem(
+            HttpStatus.BAD_REQUEST,
+            MALFORMED_REQUEST,
+            "Malformed request body",
+            MALFORMED_REQUEST_DETAIL,
+            request);
+    return handleExceptionInternal(ex, problem, headers, HttpStatus.BAD_REQUEST, request);
+  }
+
+  /**
+   * Common exit of every exception the base class handles: guarantees a {@link ProblemDetail} body
+   * whose {@code type}, {@code detail} and {@code instance} are populated, so 405/415/... share the
+   * shape of the explicitly mapped problems.
+   */
+  @Override
+  protected ResponseEntity<Object> handleExceptionInternal(
+      Exception ex,
+      Object body,
+      HttpHeaders headers,
+      HttpStatusCode statusCode,
+      WebRequest request) {
+    if (statusCode.is5xxServerError()) {
+      log.error("Unhandled exception while serving {}", request.getDescription(false), ex);
+    } else {
+      log.debug("Rejected request {}: {}", request.getDescription(false), ex.toString());
+    }
+    ProblemDetail problem;
+    if (body instanceof ProblemDetail detail) {
+      problem = detail;
+    } else if (ex instanceof ErrorResponse errorResponse) {
+      problem = errorResponse.updateAndGetBody(getMessageSource(), LocaleContextHolder.getLocale());
+    } else {
+      problem = ProblemDetail.forStatus(statusCode);
+    }
+    HttpStatus status = HttpStatus.resolve(statusCode.value());
+    String title =
+        problem.getTitle() != null
+            ? problem.getTitle()
+            : status != null ? status.getReasonPhrase() : "Error";
+    String kind = slug(title);
+    if (problem.getType() == null || "about:blank".equals(problem.getType().toString())) {
+      problem.setType(URI.create(TYPE_BASE + kind));
+    }
+    problem.setTitle(title);
+    if (problem.getDetail() == null || problem.getDetail().isBlank()) {
+      problem.setDetail(statusCode.is5xxServerError() ? INTERNAL_ERROR_DETAIL : title);
+    }
+    if (problem.getInstance() == null) {
+      problem.setInstance(instanceOf(request));
+    }
+    return super.handleExceptionInternal(ex, problem, headers, statusCode, request);
+  }
+
+  private static ResponseEntity<ProblemDetail> respond(
+      HttpStatus status, String kind, String title, String detail, WebRequest request) {
+    return ResponseEntity.status(status)
+        .contentType(MediaType.APPLICATION_PROBLEM_JSON)
+        .body(problem(status, kind, title, detail, request));
+  }
+
+  private static ProblemDetail problem(
+      HttpStatus status, String kind, String title, String detail, WebRequest request) {
+    ProblemDetail problem = ProblemDetail.forStatusAndDetail(status, detail);
+    problem.setType(URI.create(TYPE_BASE + kind));
+    problem.setTitle(title);
+    problem.setInstance(instanceOf(request));
+    return problem;
+  }
+
+  /** The request path as the problem {@code instance}; never includes the query string. */
+  private static URI instanceOf(WebRequest request) {
+    if (request instanceof ServletWebRequest servletRequest) {
+      return URI.create(servletRequest.getRequest().getRequestURI());
+    }
+    return null;
+  }
+
+  /** {@code long_url: must be an absolute http or https URL} using the JSON (snake_case) name. */
+  private static String describe(FieldError error) {
+    return snakeCase(error.getField()) + ": " + error.getDefaultMessage();
+  }
+
+  private static String snakeCase(String field) {
+    return field.replaceAll("([a-z0-9])([A-Z])", "$1_$2").toLowerCase(Locale.ROOT);
+  }
+
+  private static String slug(String title) {
+    return title.toLowerCase(Locale.ROOT).replaceAll("[^a-z0-9]+", "-").replaceAll("(^-|-$)", "");
+  }
+}
