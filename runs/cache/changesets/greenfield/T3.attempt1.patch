@@ -0,0 +1,344 @@
+package com.example.shortener.api.error;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.header;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.example.shortener.api.dto.CreateUrlRequest;
+import com.example.shortener.api.dto.CreateUrlResponse;
+import jakarta.validation.Valid;
+import java.time.OffsetDateTime;
+import java.time.ZoneOffset;
+import org.hamcrest.Matchers;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+import org.springframework.test.web.servlet.ResultActions;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RestController;
+
+/**
+ * Every error the API can produce is rendered by {@link GlobalExceptionHandler} as {@code
+ * application/problem+json} with type/title/status/detail/instance (AC-2, AC-5, AC-6, AC-16). Uses
+ * a stub controller in a standalone MockMvc so no real controller, database or Redis is involved.
+ */
+class GlobalExceptionHandlerTest {
+
+  private static final String PROBLEM_JSON = MediaType.APPLICATION_PROBLEM_JSON_VALUE;
+  private static final String INTERNAL_MARKER = "connection to db-primary-01 refused";
+
+  private MockMvc mvc;
+
+  @BeforeEach
+  void setUp() {
+    mvc =
+        MockMvcBuilders.standaloneSetup(new StubController())
+            .setControllerAdvice(new GlobalExceptionHandler())
+            .build();
+  }
+
+  // --- happy path proves the stub itself is wired ---
+
+  @Test
+  void validBodyReachesTheController() throws Exception {
+    mvc.perform(
+            post("/api/v1/urls")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(
+                    "{\"long_url\":\"https://example.com/p\",\"custom_alias\":\"promo2024\","
+                        + "\"expiration_date\":\"2030-01-01T00:00:00Z\"}"))
+        .andExpect(status().isCreated())
+        .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
+        .andExpect(jsonPath("$.short_code").value("promo2024"))
+        .andExpect(jsonPath("$.code_source").value("redis"))
+        .andExpect(jsonPath("$.expires_at").value(Matchers.startsWith("2030-01-01T00:00")));
+  }
+
+  // --- 400: Bean Validation (AC-2, AC-5, AC-6) ---
+
+  @Test
+  void ftpLongUrlIsA400ValidationProblem() throws Exception {
+    expectProblem(
+            postJson("{\"long_url\":\"ftp://example.com/file\"}"),
+            HttpStatus.BAD_REQUEST,
+            GlobalExceptionHandler.VALIDATION_FAILED,
+            "Validation failed",
+            "/api/v1/urls")
+        .andExpect(jsonPath("$.detail").value("long_url: must be an absolute http or https URL"));
+  }
+
+  @Test
+  void overlongLongUrlIsA400ValidationProblem() throws Exception {
+    String url = "https://example.com/" + "a".repeat(2029);
+
+    expectProblem(
+            postJson("{\"long_url\":\"" + url + "\"}"),
+            HttpStatus.BAD_REQUEST,
+            GlobalExceptionHandler.VALIDATION_FAILED,
+            "Validation failed",
+            "/api/v1/urls")
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("long_url")))
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("2048")));
+  }
+
+  @Test
+  void badAliasIsA400ValidationProblemNamingTheSnakeCaseField() throws Exception {
+    expectProblem(
+            postJson("{\"long_url\":\"https://example.com\",\"custom_alias\":\"ab\"}"),
+            HttpStatus.BAD_REQUEST,
+            GlobalExceptionHandler.VALIDATION_FAILED,
+            "Validation failed",
+            "/api/v1/urls")
+        .andExpect(jsonPath("$.detail").value(Matchers.startsWith("custom_alias: ")))
+        .andExpect(
+            jsonPath("$.detail").value(Matchers.not(Matchers.containsString("customAlias"))));
+  }
+
+  @Test
+  void pastExpirationDateIsA400ValidationProblem() throws Exception {
+    String past = OffsetDateTime.now(ZoneOffset.UTC).minusHours(1).toString();
+
+    expectProblem(
+            postJson("{\"long_url\":\"https://example.com\",\"expiration_date\":\"" + past + "\"}"),
+            HttpStatus.BAD_REQUEST,
+            GlobalExceptionHandler.VALIDATION_FAILED,
+            "Validation failed",
+            "/api/v1/urls")
+        .andExpect(jsonPath("$.detail").value("expiration_date: must be in the future"));
+  }
+
+  @Test
+  void multipleViolationsAreListedInOneDetail() throws Exception {
+    expectProblem(
+            postJson("{\"long_url\":\"\",\"custom_alias\":\"a-b\"}"),
+            HttpStatus.BAD_REQUEST,
+            GlobalExceptionHandler.VALIDATION_FAILED,
+            "Validation failed",
+            "/api/v1/urls")
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("custom_alias: ")))
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("long_url: ")))
+        .andExpect(jsonPath("$.detail").value(Matchers.containsString("; ")));
+  }
+
+  // --- 400: unreadable body / malformed ISO-8601 (AC-6) ---
+
+  @Test
+  void malformedExpirationDateIsA400MalformedRequestProblem() throws Exception {
+    MvcResult result =
+        expectProblem(
+                postJson(
+                    "{\"long_url\":\"https://example.com\",\"expiration_date\":\"next tuesday\"}"),
+                HttpStatus.BAD_REQUEST,
+                GlobalExceptionHandler.MALFORMED_REQUEST,
+                "Malformed request body",
+                "/api/v1/urls")
+            .andExpect(jsonPath("$.detail").value(Matchers.containsString("ISO-8601")))
+            .andReturn();
+
+    assertNoInternalsLeaked(result);
+  }
+
+  @Test
+  void unreadableJsonIsA400MalformedRequestProblem() throws Exception {
+    MvcResult result =
+        expectProblem(
+                postJson("{\"long_url\": \"https://example.com\""),
+                HttpStatus.BAD_REQUEST,
+                GlobalExceptionHandler.MALFORMED_REQUEST,
+                "Malformed request body",
+                "/api/v1/urls")
+            .andReturn();
+
+    assertNoInternalsLeaked(result);
+  }
+
+  @Test
+  void emptyBodyIsA400MalformedRequestProblem() throws Exception {
+    expectProblem(
+        postJson(""),
+        HttpStatus.BAD_REQUEST,
+        GlobalExceptionHandler.MALFORMED_REQUEST,
+        "Malformed request body",
+        "/api/v1/urls");
+  }
+
+  // --- explicit domain exceptions ---
+
+  @Test
+  void invalidUrlExceptionIsA400WithItsMessageAsDetail() throws Exception {
+    expectProblem(
+            mvc.perform(get("/throw/invalid-url")),
+            HttpStatus.BAD_REQUEST,
+            GlobalExceptionHandler.INVALID_URL,
+            "Invalid URL",
+            "/throw/invalid-url")
+        .andExpect(jsonPath("$.detail").value("long_url host must not be empty"));
+  }
+
+  @Test
+  void shortCodeNotFoundIsA404() throws Exception {
+    expectProblem(
+            mvc.perform(get("/throw/not-found")),
+            HttpStatus.NOT_FOUND,
+            GlobalExceptionHandler.SHORT_CODE_NOT_FOUND,
+            "Short code not found",
+            "/throw/not-found")
+        .andExpect(jsonPath("$.detail").value("Short code 'nope42' was not found"));
+  }
+
+  @Test
+  void aliasAlreadyExistsIsA409() throws Exception {
+    expectProblem(
+            mvc.perform(get("/throw/alias-taken")),
+            HttpStatus.CONFLICT,
+            GlobalExceptionHandler.ALIAS_ALREADY_EXISTS,
+            "Alias already exists",
+            "/throw/alias-taken")
+        .andExpect(jsonPath("$.detail").value("Alias 'promo2024' already exists"));
+  }
+
+  @Test
+  void shortCodeExpiredIsA410() throws Exception {
+    expectProblem(
+            mvc.perform(get("/throw/expired")),
+            HttpStatus.GONE,
+            GlobalExceptionHandler.SHORT_CODE_EXPIRED,
+            "Short code expired",
+            "/throw/expired")
+        .andExpect(jsonPath("$.detail").value("Short code 'old123' has expired"));
+  }
+
+  // --- 500 (AC-16): consistent body, nothing internal leaked ---
+
+  @Test
+  void unhandledExceptionIsA500WithoutLeakingInternals() throws Exception {
+    MvcResult result =
+        expectProblem(
+                mvc.perform(get("/throw/boom")),
+                HttpStatus.INTERNAL_SERVER_ERROR,
+                GlobalExceptionHandler.INTERNAL_ERROR,
+                "Internal server error",
+                "/throw/boom")
+            .andExpect(jsonPath("$.detail").value(Matchers.not(Matchers.containsString("refused"))))
+            .andReturn();
+
+    assertNoInternalsLeaked(result);
+  }
+
+  @Test
+  void unhandledErrorSubclassIsAlsoA500() throws Exception {
+    MvcResult result =
+        expectProblem(
+                mvc.perform(get("/throw/error")),
+                HttpStatus.INTERNAL_SERVER_ERROR,
+                GlobalExceptionHandler.INTERNAL_ERROR,
+                "Internal server error",
+                "/throw/error")
+            .andReturn();
+
+    assertNoInternalsLeaked(result);
+  }
+
+  // --- exceptions raised by Spring MVC itself share the same shape ---
+
+  @Test
+  void methodNotAllowedFromSpringIsRenderedWithTheSameShape() throws Exception {
+    expectProblem(
+        mvc.perform(delete("/api/v1/urls")),
+        HttpStatus.METHOD_NOT_ALLOWED,
+        "method-not-allowed",
+        "Method Not Allowed",
+        "/api/v1/urls");
+  }
+
+  @Test
+  void unsupportedMediaTypeFromSpringIsRenderedWithTheSameShape() throws Exception {
+    expectProblem(
+        mvc.perform(post("/api/v1/urls").contentType(MediaType.TEXT_PLAIN).content("long_url=x")),
+        HttpStatus.UNSUPPORTED_MEDIA_TYPE,
+        "unsupported-media-type",
+        "Unsupported Media Type",
+        "/api/v1/urls");
+  }
+
+  // --- helpers ---
+
+  private ResultActions postJson(String body) throws Exception {
+    return mvc.perform(post("/api/v1/urls").contentType(MediaType.APPLICATION_JSON).content(body));
+  }
+
+  private static ResultActions expectProblem(
+      ResultActions actions, HttpStatus status, String kind, String title, String instance)
+      throws Exception {
+    return actions
+        .andExpect(status().is(status.value()))
+        .andExpect(header().string("Content-Type", Matchers.startsWith(PROBLEM_JSON)))
+        .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON))
+        .andExpect(jsonPath("$.type").value(GlobalExceptionHandler.TYPE_BASE + kind))
+        .andExpect(jsonPath("$.title").value(title))
+        .andExpect(jsonPath("$.status").value(status.value()))
+        .andExpect(jsonPath("$.detail").isString())
+        .andExpect(jsonPath("$.detail").value(Matchers.not(Matchers.emptyString())))
+        .andExpect(jsonPath("$.instance").value(instance));
+  }
+
+  private static void assertNoInternalsLeaked(MvcResult result) throws Exception {
+    String body = result.getResponse().getContentAsString();
+
+    assertThat(body)
+        .doesNotContain(INTERNAL_MARKER)
+        .doesNotContain("Exception")
+        .doesNotContain("stackTrace")
+        .doesNotContain("trace")
+        .doesNotContain("com.example")
+        .doesNotContain("tools.jackson")
+        .doesNotContain("org.springframework")
+        .doesNotContainPattern("\\bat \\w");
+  }
+
+  /** Minimal stand-in for the real write/read controllers; only raises what the handler maps. */
+  @RestController
+  static class StubController {
+
+    @PostMapping(path = "/api/v1/urls", consumes = MediaType.APPLICATION_JSON_VALUE)
+    ResponseEntity<CreateUrlResponse> create(@Valid @RequestBody CreateUrlRequest request) {
+      String code = request.customAlias() == null ? "aB3x9" : request.customAlias();
+      return ResponseEntity.status(HttpStatus.CREATED)
+          .body(
+              new CreateUrlResponse(
+                  "http://localhost:8080/" + code,
+                  code,
+                  request.longUrl(),
+                  request.expirationDate(),
+                  "redis"));
+    }
+
+    @GetMapping("/throw/{kind}")
+    String raise(@PathVariable String kind) {
+      switch (kind) {
+        case "invalid-url" -> throw new InvalidUrlException("long_url host must not be empty");
+        case "not-found" -> throw new ShortCodeNotFoundException("nope42");
+        case "alias-taken" -> throw new AliasAlreadyExistsException("promo2024");
+        case "expired" -> throw new ShortCodeExpiredException("old123");
+        case "boom" -> throw new IllegalStateException(INTERNAL_MARKER);
+        case "error" -> throw new AssertionError(INTERNAL_MARKER);
+        default -> {
+          return "ok";
+        }
+      }
+    }
+  }
+}
