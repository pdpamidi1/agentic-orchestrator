--- /dev/null
+++ b/src/main/resources/application-read.yml
@@ -0,0 +1,22 @@
+# "read" deployment profile: the redirect surface.
+#
+# Instances started with SPRING_PROFILES_ACTIVE=read only register the read-side beans
+# (@Profile("read")): short-code lookup, cache read-through and 3xx redirects.
+# They never allocate short codes, so no counter batches are reserved from Redis.
+# Scale these horizontally behind the public hostname configured in shortener.base-url.
+
+spring:
+  config:
+    activate:
+      on-profile: read
+  jpa:
+    properties:
+      hibernate:
+        connection:
+          provider_disables_autocommit: true
+
+server:
+  # Redirect-heavy traffic; keep connections cheap.
+  tomcat:
+    threads:
+      max: 200
diff --git a/src/main/resources/application-write.yml b/src/main/resources/application-write.yml
new file mode 100644
index 0000000..d8ba462
--- /dev/null
+++ b/src/main/resources/application-write.yml
@@ -0,0 +1,16 @@
+# "write" deployment profile: the short-link creation surface.
+#
+# Instances started with SPRING_PROFILES_ACTIVE=write only register the write-side beans
+# (@Profile("write")): URL validation, short-code allocation from the Redis counter (in batches
+# of shortener.counter-batch-size, seeded by shortener.counter-seed-offset) and persistence.
+# Fewer instances are needed here than on the read side; each one owns its counter batch.
+
+spring:
+  config:
+    activate:
+      on-profile: write
+
+server:
+  tomcat:
+    threads:
+      max: 50
