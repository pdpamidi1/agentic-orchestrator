new file mode 100644
index 0000000..cbc6c20
--- /dev/null
+++ b/src/main/java/com/example/shortener/domain/CodeSource.java
@@ -0,0 +1,58 @@
+package com.example.shortener.domain;
+
+import jakarta.persistence.AttributeConverter;
+import jakarta.persistence.Converter;
+
+/**
+ * Which counter produced a generated short code. The wire value is what is persisted in {@code
+ * urls.code_source} and must stay in sync with the {@code urls_code_source_chk} constraint of
+ * {@code V1__create_urls_table.sql}.
+ */
+public enum CodeSource {
+  /** Batched Redis {@code INCRBY} counter (ADR-001). */
+  REDIS("redis"),
+  /** Postgres sequence {@code url_code_seq}, used when Redis is unavailable (ADR-002). */
+  DB_SEQUENCE("db_sequence");
+
+  private final String wireValue;
+
+  CodeSource(String wireValue) {
+    this.wireValue = wireValue;
+  }
+
+  /** The value persisted in the database and exposed in logs. */
+  public String wireValue() {
+    return wireValue;
+  }
+
+  /**
+   * Looks up the enum constant by its persisted value.
+   *
+   * @param wireValue value read from {@code urls.code_source}
+   * @return the matching constant
+   * @throws IllegalArgumentException when no constant has that wire value
+   */
+  public static CodeSource fromWire(String wireValue) {
+    for (CodeSource source : values()) {
+      if (source.wireValue.equals(wireValue)) {
+        return source;
+      }
+    }
+    throw new IllegalArgumentException("Unknown code_source value: " + wireValue);
+  }
+
+  /** JPA converter persisting {@link CodeSource} as its wire value; applied automatically. */
+  @Converter(autoApply = true)
+  public static final class WireConverter implements AttributeConverter<CodeSource, String> {
+
+    @Override
+    public String convertToDatabaseColumn(CodeSource attribute) {
+      return attribute == null ? null : attribute.wireValue();
+    }
+
+    @Override
+    public CodeSource convertToEntityAttribute(String dbData) {
+      return dbData == null ? null : fromWire(dbData);
+    }
+  }
+}
diff --git a/src/main/java/com/example/shortener/domain/UrlMapping.java b/src/main/java/com/example/shortener/domain/UrlMapping.java
new file mode 100644
index 0000000..19cf43f
--- /dev/null
+++ b/src/main/java/com/example/shortener/domain/UrlMapping.java
@@ -0,0 +1,127 @@
+package com.example.shortener.domain;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Convert;
+import jakarta.persistence.Entity;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.time.Instant;
+import java.util.Objects;
+
+/**
+ * A short-code to long-URL mapping; one row of the {@code urls} table created by {@code
+ * V1__create_urls_table.sql}. Columns map 1:1: short_code (PK), long_url, created_at, expires_at,
+ * created_by (always null in this release), code_source.
+ *
+ * <p>The domain package knows only JPA and {@link CodeSource}; it never depends on web, service or
+ * codegen classes.
+ */
+@Entity
+@Table(name = "urls")
+public class UrlMapping {
+
+  @Id
+  @Column(name = "short_code", nullable = false, length = 32)
+  private String shortCode;
+
+  @Column(name = "long_url", nullable = false, length = 2048)
+  private String longUrl;
+
+  @Column(name = "created_at", nullable = false)
+  private Instant createdAt;
+
+  @Column(name = "expires_at")
+  private Instant expiresAt;
+
+  /** Reserved for a future auth scenario; never populated (and never PII) in this release. */
+  @Column(name = "created_by", length = 255)
+  private String createdBy;
+
+  @Convert(converter = CodeSource.WireConverter.class)
+  @Column(name = "code_source", nullable = false, length = 16)
+  private CodeSource codeSource;
+
+  /** Required by JPA. */
+  protected UrlMapping() {}
+
+  /**
+   * Creates a mapping with {@code created_by} left null.
+   *
+   * @param shortCode generated base62 code or custom alias (the primary key)
+   * @param longUrl absolute target URL
+   * @param createdAt creation instant (UTC)
+   * @param expiresAt expiry instant, or {@code null} when the mapping never expires
+   * @param codeSource which counter produced the code
+   */
+  public UrlMapping(
+      String shortCode,
+      String longUrl,
+      Instant createdAt,
+      Instant expiresAt,
+      CodeSource codeSource) {
+    this.shortCode = Objects.requireNonNull(shortCode, "shortCode");
+    this.longUrl = Objects.requireNonNull(longUrl, "longUrl");
+    this.createdAt = Objects.requireNonNull(createdAt, "createdAt");
+    this.expiresAt = expiresAt;
+    this.codeSource = Objects.requireNonNull(codeSource, "codeSource");
+  }
+
+  /**
+   * Whether this mapping has expired.
+   *
+   * @param now the reference instant
+   * @return {@code true} only when {@code expires_at} is set and is at or before {@code now}; a
+   *     mapping without an expiry never expires
+   */
+  public boolean isExpired(Instant now) {
+    Objects.requireNonNull(now, "now");
+    return expiresAt != null && !expiresAt.isAfter(now);
+  }
+
+  public String getShortCode() {
+    return shortCode;
+  }
+
+  public String getLongUrl() {
+    return longUrl;
+  }
+
+  public Instant getCreatedAt() {
+    return createdAt;
+  }
+
+  public Instant getExpiresAt() {
+    return expiresAt;
+  }
+
+  public String getCreatedBy() {
+    return createdBy;
+  }
+
+  public CodeSource getCodeSource() {
+    return codeSource;
+  }
+
+  @Override
+  public boolean equals(Object o) {
+    return this == o || (o instanceof UrlMapping other && shortCode.equals(other.shortCode));
+  }
+
+  @Override
+  public int hashCode() {
+    return shortCode.hashCode();
+  }
+
+  @Override
+  public String toString() {
+    return "UrlMapping[shortCode="
+        + shortCode
+        + ", createdAt="
+        + createdAt
+        + ", expiresAt="
+        + expiresAt
+        + ", codeSource="
+        + codeSource
+        + "]";
+  }
+}
