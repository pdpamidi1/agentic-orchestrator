--- /dev/null
+++ b/src/main/java/com/example/shortener/api/dto/CreateUrlRequest.java
@@ -0,0 +1,60 @@
+package com.example.shortener.api.dto;
+
+import com.fasterxml.jackson.annotation.JsonProperty;
+import jakarta.validation.constraints.Future;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.Pattern;
+import jakarta.validation.constraints.Size;
+import java.time.OffsetDateTime;
+
+/**
+ * Request body of {@code POST /api/v1/urls} (operationId {@code createShortUrl}).
+ *
+ * <p>JSON property names are snake_case. Bean Validation enforces the contract (AC-2, AC-5, AC-6):
+ *
+ * <ul>
+ *   <li>{@code long_url}: required, at most {@value #LONG_URL_MAX_LENGTH} characters, absolute
+ *       {@code http} or {@code https} URL.
+ *   <li>{@code custom_alias}: optional, {@code [0-9a-zA-Z]} with length {@value
+ *       #ALIAS_MIN_LENGTH}-{@value #ALIAS_MAX_LENGTH}.
+ *   <li>{@code expiration_date}: optional ISO-8601 date-time with offset; must lie in the future.
+ *       A malformed value is rejected while the body is read, before validation runs.
+ * </ul>
+ *
+ * @param longUrl the destination URL
+ * @param customAlias caller-chosen short code, or {@code null} to have one generated
+ * @param expirationDate moment after which the short link stops resolving, or {@code null} for
+ *     no expiry
+ */
+public record CreateUrlRequest(
+    @JsonProperty("long_url")
+        @NotBlank(message = "must not be blank")
+        @Size(max = LONG_URL_MAX_LENGTH, message = "must be at most 2048 characters")
+        @Pattern(
+            regexp = LONG_URL_PATTERN,
+            flags = Pattern.Flag.CASE_INSENSITIVE,
+            message = "must be an absolute http or https URL")
+        String longUrl,
+    @JsonProperty("custom_alias")
+        @Pattern(
+            regexp = ALIAS_PATTERN,
+            message = "must be 3 to 32 characters from [0-9a-zA-Z]")
+        String customAlias,
+    @JsonProperty("expiration_date") @Future(message = "must be in the future")
+        OffsetDateTime expirationDate) {
+
+  /** Maximum accepted length of {@code long_url}, in characters. */
+  public static final int LONG_URL_MAX_LENGTH = 2048;
+
+  /** Minimum length of {@code custom_alias}. */
+  public static final int ALIAS_MIN_LENGTH = 3;
+
+  /** Maximum length of {@code custom_alias}. */
+  public static final int ALIAS_MAX_LENGTH = 32;
+
+  /** Absolute http/https URL: scheme, {@code ://} and at least one non-whitespace character. */
+  public static final String LONG_URL_PATTERN = "^https?://\\S+$";
+
+  /** Alphanumeric alias of 3 to 32 characters. */
+  public static final String ALIAS_PATTERN = "^[0-9a-zA-Z]{3,32}$";
+}
diff --git a/src/main/java/com/example/shortener/domain/CodeSource.java b/src/main/java/com/example/shortener/domain/CodeSource.java
