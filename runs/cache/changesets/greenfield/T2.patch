+++ b/src/main/java/com/example/shortener/domain/UrlMappingRepository.java
@@ -0,0 +1,26 @@
+package com.example.shortener.domain;
+
+import java.util.Optional;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+
+/**
+ * Spring Data JPA repository of {@link UrlMapping} rows, plus the fallback counter read (ADR-002).
+ * Uniqueness of a short code is ultimately enforced by the primary key; {@link #existsByShortCode}
+ * is only a pre-check.
+ */
+public interface UrlMappingRepository extends JpaRepository<UrlMapping, String> {
+
+  /** Finds the mapping with the given short code, if any. */
+  Optional<UrlMapping> findByShortCode(String shortCode);
+
+  /** Whether a mapping with the given short code already exists. */
+  boolean existsByShortCode(String shortCode);
+
+  /**
+   * Draws the next value of the Postgres sequence {@code url_code_seq}, the counter used when Redis
+   * is unavailable. Values are never reused; gaps are acceptable.
+   */
+  @Query(value = "SELECT nextval('url_code_seq')", nativeQuery = true)
+  long nextSequenceValue();
+}
diff --git a/src/main/resources/db/migration/V1__create_urls_table.sql b/src/main/resources/db/migration/V1__create_urls_table.sql
new file mode 100644
index 0000000..067f744
--- /dev/null
+++ b/src/main/resources/db/migration/V1__create_urls_table.sql
@@ -0,0 +1,32 @@
+-- V1: urls table (source of truth for short-code -> long-URL mappings) and the fallback counter sequence.
+--
+-- Forward-only Flyway migration (ADR-010). Never edit this file once it has run anywhere; every later
+-- schema change is a new Vn__*.sql following expand/contract.
+--
+-- created_by is reserved for a future auth scenario and is always NULL in this release (never PII).
+-- code_source is a plain varchar with a CHECK constraint (not a Postgres ENUM) so a third source can be
+-- added by altering the constraint instead of migrating a type.
+
+CREATE TABLE urls (
+    short_code  varchar(32)   NOT NULL,
+    long_url    varchar(2048) NOT NULL,
+    created_at  timestamptz   NOT NULL DEFAULT now(),
+    expires_at  timestamptz   NULL,
+    created_by  varchar(255)  NULL,
+    code_source varchar(16)   NOT NULL,
+    CONSTRAINT pk_urls PRIMARY KEY (short_code),
+    CONSTRAINT urls_code_source_chk CHECK (code_source IN ('redis', 'db_sequence')),
+    CONSTRAINT urls_short_code_format_chk CHECK (short_code ~ '^[0-9a-zA-Z]{3,32}$'),
+    CONSTRAINT urls_long_url_len_chk CHECK (char_length(long_url) BETWEEN 1 AND 2048)
+);
+
+-- Partial index supporting expiry lookups and sweeps; rows that never expire are not indexed.
+CREATE INDEX idx_urls_expires_at ON urls (expires_at) WHERE expires_at IS NOT NULL;
+
+-- Fallback short-code counter used when Redis is unavailable (ADR-002). Seeded at 62^3 = 238328 (AMB-11)
+-- so every base62 code produced from it is at least three characters. Values are never reused; gaps are fine.
+CREATE SEQUENCE url_code_seq START WITH 238328 INCREMENT BY 1 NO CYCLE CACHE 1;
+
+COMMENT ON COLUMN urls.created_by IS 'Reserved for a future auth scenario; left NULL in this release';
+COMMENT ON COLUMN urls.code_source IS 'redis = batched Redis INCRBY counter, db_sequence = url_code_seq fallback';
+COMMENT ON SEQUENCE url_code_seq IS 'Fallback short-code counter, seeded at 62^3 so codes are >= 3 chars';
diff --git a/src/test/java/com/example/shortener/domain/MigrationScriptTest.java b/src/test/java/com/example/shortener/domain/MigrationScriptTest.java
new file mode 100644
index 0000000..21a45e2
--- /dev/null
+++ b/src/test/java/com/example/shortener/domain/MigrationScriptTest.java
@@ -0,0 +1,116 @@
+package com.example.shortener.domain;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Static checks of the Flyway migration creating the {@code urls} table and the {@code
+ * url_code_seq} fallback sequence (AC-15, AC-11). Reads the SQL file from the source tree; no
+ * container needed.
+ */
+class MigrationScriptTest {
+
+  private static final Path MIGRATIONS = Path.of("src/main/resources/db/migration");
+  private static final Pattern VERSIONED = Pattern.compile("^V1__[A-Za-z0-9_]+\\.sql$");
+
+  /** 62^3: the AMB-11 seed offset guaranteeing at least three base62 characters. */
+  private static final long SEED_OFFSET = 238_328L;
+
+  private static String sql;
+  private static String normalized;
+
+  @BeforeAll
+  static void readMigration() throws IOException {
+    sql = Files.readString(MIGRATIONS.resolve("V1__create_urls_table.sql"), StandardCharsets.UTF_8);
+    normalized = stripComments(sql).replaceAll("\\s+", " ").toLowerCase();
+  }
+
+  @Test
+  void migrationFileExistsAndFollowsFlywayVersionedNaming() throws IOException {
+    Path file = MIGRATIONS.resolve("V1__create_urls_table.sql");
+
+    assertThat(file).isRegularFile();
+    assertThat(VERSIONED.matcher(file.getFileName().toString()).matches()).isTrue();
+    assertThat(sql).isNotBlank();
+  }
+
+  @Test
+  void exactlyOneVersionOneMigrationExists() throws IOException {
+    try (Stream<Path> files = Files.list(MIGRATIONS)) {
+      List<String> v1 =
+          files.map(p -> p.getFileName().toString()).filter(n -> n.startsWith("V1__")).toList();
+      assertThat(v1).containsExactly("V1__create_urls_table.sql");
+    }
+  }
+
+  @Test
+  void migrationIsAlsoOnTheClasspathWhereFlywayLooks() {
+    assertThat(getClass().getResource("/db/migration/V1__create_urls_table.sql")).isNotNull();
+  }
+
+  @Test
+  void createsTheUrlsTableWithEveryRequiredColumn() {
+    assertThat(normalized).contains("create table urls (");
+    assertThat(normalized).contains("short_code varchar(32) not null");
+    assertThat(normalized).contains("long_url varchar(2048) not null");
+    assertThat(normalized).contains("created_at timestamptz not null");
+    assertThat(normalized).contains("expires_at timestamptz null");
+    assertThat(normalized).contains("created_by varchar(255) null");
+    assertThat(normalized).contains("code_source varchar(16) not null");
+  }
+
+  @Test
+  void shortCodeIsThePrimaryKey() {
+    assertThat(normalized).contains("primary key (short_code)");
+  }
+
+  @Test
+  void codeSourceIsConstrainedToTheEnumWireValues() {
+    assertThat(normalized).contains("check (code_source in ('redis', 'db_sequence'))");
+    for (CodeSource source : CodeSource.values()) {
+      assertThat(normalized).contains("'" + source.wireValue() + "'");
+    }
+  }
+
+  @Test
+  void shortCodeFormatAndLongUrlLengthAreChecked() {
+    assertThat(normalized).contains("check (short_code ~ '^[0-9a-za-z]{3,32}$')");
+    assertThat(normalized).contains("check (char_length(long_url) between 1 and 2048)");
+  }
+
+  @Test
+  void createsAnIndexSupportingExpiryLookups() {
+    assertThat(normalized)
+        .contains(
+            "create index idx_urls_expires_at on urls (expires_at) where expires_at is not null");
+  }
+
+  @Test
+  void createsTheFallbackSequenceSeededPastTheOffset() {
+    Matcher m =
+        Pattern.compile("create sequence url_code_seq start with (\\d+) increment by 1 no cycle")
+            .matcher(normalized);
+
+    assertThat(m.find()).as("url_code_seq definition").isTrue();
+    assertThat(Long.parseLong(m.group(1))).isGreaterThanOrEqualTo(SEED_OFFSET);
+  }
+
+  @Test
+  void containsNoDestructiveStatements() {
+    assertThat(normalized).doesNotContain("drop ", "truncate ", "delete from ", "alter table ");
+  }
+
+  private static String stripComments(String text) {
+    return text.lines().map(l -> l.replaceFirst("--.*$", "")).reduce("", (a, b) -> a + "\n" + b);
+  }
+}
diff --git a/src/test/java/com/example/shortener/domain/UrlMappingTest.java b/src/test/java/com/example/shortener/domain/UrlMappingTest.java
new file mode 100644
index 0000000..36e2337
--- /dev/null
+++ b/src/test/java/com/example/shortener/domain/UrlMappingTest.java
@@ -0,0 +1,216 @@
+package com.example.shortener.domain;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Convert;
+import jakarta.persistence.Entity;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+import java.lang.reflect.Field;
+import java.time.Instant;
+import java.util.Arrays;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+
+/** Unit tests of the domain entity, its enum and the repository contract; no database needed. */
+class UrlMappingTest {
+
+  private static final Instant NOW = Instant.parse("2026-09-14T12:00:00Z");
+
+  private static UrlMapping mapping(Instant expiresAt) {
+    return new UrlMapping(
+        "abc",
+        "https://example.com/some/path",
+        NOW.minusSeconds(3600),
+        expiresAt,
+        CodeSource.REDIS);
+  }
+
+  // --- isExpired (AC-3/AC-4 helper; redirect returns 410 once expired) ---
+
+  @Test
+  void neverExpiredWhenExpiresAtIsNull() {
+    UrlMapping mapping = mapping(null);
+
+    assertThat(mapping.isExpired(NOW)).isFalse();
+    assertThat(mapping.isExpired(Instant.MAX)).isFalse();
+  }
+
+  @Test
+  void notExpiredBeforeExpiresAt() {
+    UrlMapping mapping = mapping(NOW.plusSeconds(1));
+
+    assertThat(mapping.isExpired(NOW)).isFalse();
+  }
+
+  @Test
+  void expiredExactlyAtExpiresAt() {
+    UrlMapping mapping = mapping(NOW);
+
+    assertThat(mapping.isExpired(NOW)).isTrue();
+  }
+
+  @Test
+  void expiredAfterExpiresAt() {
+    UrlMapping mapping = mapping(NOW.minusMillis(1));
+
+    assertThat(mapping.isExpired(NOW)).isTrue();
+  }
+
+  @Test
+  void isExpiredRejectsNullReference() {
+    assertThatThrownBy(() -> mapping(null).isExpired(null))
+        .isInstanceOf(NullPointerException.class);
+  }
+
+  // --- constructor / accessors (AC-1: created_by is always null) ---
+
+  @Test
+  void constructorLeavesCreatedByNullAndExposesEveryColumn() {
+    UrlMapping mapping = mapping(NOW.plusSeconds(60));
+
+    assertThat(mapping.getShortCode()).isEqualTo("abc");
+    assertThat(mapping.getLongUrl()).isEqualTo("https://example.com/some/path");
+    assertThat(mapping.getCreatedAt()).isEqualTo(NOW.minusSeconds(3600));
+    assertThat(mapping.getExpiresAt()).isEqualTo(NOW.plusSeconds(60));
+    assertThat(mapping.getCreatedBy()).isNull();
+    assertThat(mapping.getCodeSource()).isEqualTo(CodeSource.REDIS);
+  }
+
+  @Test
+  void requiredFieldsAreRejectedWhenNull() {
+    assertThatThrownBy(() -> new UrlMapping(null, "https://e.com", NOW, null, CodeSource.REDIS))
+        .isInstanceOf(NullPointerException.class);
+    assertThatThrownBy(() -> new UrlMapping("abc", null, NOW, null, CodeSource.REDIS))
+        .isInstanceOf(NullPointerException.class);
+    assertThatThrownBy(() -> new UrlMapping("abc", "https://e.com", null, null, CodeSource.REDIS))
+        .isInstanceOf(NullPointerException.class);
+    assertThatThrownBy(() -> new UrlMapping("abc", "https://e.com", NOW, null, null))
+        .isInstanceOf(NullPointerException.class);
+  }
+
+  @Test
+  void identityIsTheShortCode() {
+    UrlMapping a = mapping(null);
+    UrlMapping b = new UrlMapping("abc", "https://other.example", NOW, NOW, CodeSource.DB_SEQUENCE);
+    UrlMapping c =
+        new UrlMapping("abd", "https://example.com/some/path", NOW, null, CodeSource.REDIS);
+
+    assertThat(a).isEqualTo(b).hasSameHashCodeAs(b).isNotEqualTo(c);
+    assertThat(a.toString()).contains("abc").doesNotContain("example.com");
+  }
+
+  // --- JPA mapping is 1:1 with V1__create_urls_table.sql (AC-15) ---
+
+  @Test
+  void entityIsMappedToTheUrlsTable() {
+    assertThat(UrlMapping.class.isAnnotationPresent(Entity.class)).isTrue();
+    assertThat(UrlMapping.class.getAnnotation(Table.class).name()).isEqualTo("urls");
+  }
+
+  @Test
+  void everyMigrationColumnIsMappedWithMatchingNullabilityAndLength() throws Exception {
+    Map<String, boolean[]> expected =
+        Map.of(
+            "shortCode", new boolean[] {false},
+            "longUrl", new boolean[] {false},
+            "createdAt", new boolean[] {false},
+            "expiresAt", new boolean[] {true},
+            "createdBy", new boolean[] {true},
+            "codeSource", new boolean[] {false});
+    Map<String, String> columnNames =
+        Map.of(
+            "shortCode", "short_code",
+            "longUrl", "long_url",
+            "createdAt", "created_at",
+            "expiresAt", "expires_at",
+            "createdBy", "created_by",
+            "codeSource", "code_source");
+
+    assertThat(Arrays.stream(UrlMapping.class.getDeclaredFields()).map(Field::getName))
+        .containsExactlyInAnyOrderElementsOf(expected.keySet());
+
+    for (String fieldName : expected.keySet()) {
+      Column column = UrlMapping.class.getDeclaredField(fieldName).getAnnotation(Column.class);
+      assertThat(column).as(fieldName).isNotNull();
+      assertThat(column.name()).isEqualTo(columnNames.get(fieldName));
+      assertThat(column.nullable()).as(fieldName).isEqualTo(expected.get(fieldName)[0]);
+    }
+
+    assertThat(UrlMapping.class.getDeclaredField("shortCode").isAnnotationPresent(Id.class))
+        .isTrue();
+    assertThat(column("shortCode").length()).isEqualTo(32);
+    assertThat(column("longUrl").length()).isEqualTo(2048);
+    assertThat(column("createdBy").length()).isEqualTo(255);
+    assertThat(column("codeSource").length()).isEqualTo(16);
+    assertThat(UrlMapping.class.getDeclaredField("createdAt").getType()).isEqualTo(Instant.class);
+    assertThat(UrlMapping.class.getDeclaredField("expiresAt").getType()).isEqualTo(Instant.class);
+    assertThat(UrlMapping.class.getDeclaredField("codeSource").getAnnotation(Convert.class))
+        .isNotNull()
+        .extracting(Convert::converter)
+        .isEqualTo(CodeSource.WireConverter.class);
+  }
+
+  private static Column column(String field) throws NoSuchFieldException {
+    return UrlMapping.class.getDeclaredField(field).getAnnotation(Column.class);
+  }
+
+  // --- CodeSource wire values match the urls_code_source_chk constraint (AC-11) ---
+
+  @Test
+  void codeSourceWireValuesMatchTheCheckConstraint() {
+    assertThat(CodeSource.REDIS.wireValue()).isEqualTo("redis");
+    assertThat(CodeSource.DB_SEQUENCE.wireValue()).isEqualTo("db_sequence");
+    assertThat(CodeSource.values()).containsExactly(CodeSource.REDIS, CodeSource.DB_SEQUENCE);
+  }
+
+  @Test
+  void codeSourceFromWireRoundTripsAndRejectsUnknownValues() {
+    for (CodeSource source : CodeSource.values()) {
+      assertThat(CodeSource.fromWire(source.wireValue())).isSameAs(source);
+    }
+    assertThatThrownBy(() -> CodeSource.fromWire("REDIS"))
+        .isInstanceOf(IllegalArgumentException.class)
+        .hasMessageContaining("REDIS");
+    assertThatThrownBy(() -> CodeSource.fromWire(null))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+
+  @Test
+  void codeSourceConverterPersistsTheWireValue() {
+    CodeSource.WireConverter converter = new CodeSource.WireConverter();
+
+    assertThat(converter.convertToDatabaseColumn(CodeSource.DB_SEQUENCE)).isEqualTo("db_sequence");
+    assertThat(converter.convertToEntityAttribute("redis")).isEqualTo(CodeSource.REDIS);
+    assertThat(converter.convertToDatabaseColumn(null)).isNull();
+    assertThat(converter.convertToEntityAttribute(null)).isNull();
+    assertThat(
+            CodeSource.WireConverter.class
+                .getAnnotation(jakarta.persistence.Converter.class)
+                .autoApply())
+        .isTrue();
+  }
+
+  // --- repository contract (AC-11: nextval('url_code_seq') fallback) ---
+
+  @Test
+  void repositoryExposesLookupsAndTheSequenceFallback() throws Exception {
+    assertThat(JpaRepository.class).isAssignableFrom(UrlMappingRepository.class);
+    assertThat(
+            UrlMappingRepository.class.getMethod("findByShortCode", String.class).getReturnType())
+        .isEqualTo(java.util.Optional.class);
+    assertThat(
+            UrlMappingRepository.class.getMethod("existsByShortCode", String.class).getReturnType())
+        .isEqualTo(boolean.class);
+
+    Query query =
+        UrlMappingRepository.class.getMethod("nextSequenceValue").getAnnotation(Query.class);
+    assertThat(query).isNotNull();
+    assertThat(query.nativeQuery()).isTrue();
+    assertThat(query.value()).isEqualToIgnoringCase("SELECT nextval('url_code_seq')");
+  }
+}
