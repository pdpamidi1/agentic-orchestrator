<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.0</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>url-shortener</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>url-shortener</name>
  <description>URL shortener service (Spring Boot 4 / Java 25)</description>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <springdoc.version>3.0.0</springdoc.version>
    <springdoc-maven-plugin.version>1.5</springdoc-maven-plugin.version>
    <testcontainers-redis.version>2.2.4</testcontainers-redis.version>
    <spotless.version>2.44.4</spotless.version>
    <google-java-format.version>1.27.0</google-java-format.version>

    <!--
      Integration-test ("it") profile knobs. The application is started once from the *test*
      classpath so that the springdoc OpenAPI dump can be taken from the running app. The
      datasource defaults to a Testcontainers JDBC URL: the PostgreSQL container is started on
      demand by org.testcontainers.jdbc.ContainerDatabaseDriver and reaped when the JVM stops.
      Later tasks may point it.app.mainClass at a Testcontainers-backed test launcher instead
      (e.g. com.example.shortener.it.TestUrlShortenerApplication) without touching the profile.
    -->
    <it.app.mainClass>com.example.shortener.UrlShortenerApplication</it.app.mainClass>
    <it.app.port>8080</it.app.port>
    <it.datasource.url>jdbc:tc:postgresql:17-alpine:///shortener</it.datasource.url>
    <it.datasource.driver>org.testcontainers.jdbc.ContainerDatabaseDriver</it.datasource.driver>
    <it.datasource.username>test</it.datasource.username>
    <it.datasource.password>test</it.datasource.password>
  </properties>

  <dependencies>
    <!-- Web / API -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Cache / counter -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!--
      Click analytics (T1). The starter brings org.springframework.kafka:spring-kafka plus Boot's
      Kafka auto-configuration (KafkaTemplate, spring.kafka.*). No broker connection is opened at
      start-up: producers connect on first send and there is no listener until a later task adds one.
      Retry/backoff for the outbox relay uses the framework's built-in org.springframework.core.retry
      (RetryTemplate / RetryPolicy with exponential backoff and jitter, Spring Framework 7), so no
      additional resilience library is required; the knobs live in AnalyticsProperties.retry.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.redis</groupId>
      <artifactId>testcontainers-redis</artifactId>
      <version>${testcontainers-redis.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Kafka test support (T1): embedded broker for unit-level tests, container for *IT.java. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Unit tests only: `./mvnw test` never needs Docker. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- `./mvnw spotless:check` / `./mvnw spotless:apply` -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <excludes>
              <!-- Generated by the orchestrator from the design; never edited by hand. -->
              <exclude>src/test/java/sdlc/**/*.java</exclude>
            </excludes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
              <reflowLongStrings>true</reflowLongStrings>
            </googleJavaFormat>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      `./mvnw -Pit verify`
        1. pre-integration-test : spring-boot:start boots the app (test classpath, Testcontainers PostgreSQL)
        2. integration-test     : springdoc dumps target/openapi.json + target/openapi.yaml,
                                  failsafe runs **/*IT.java
        3. post-integration-test: spring-boot:stop
        4. verify               : failsafe:verify fails the build on IT failures
    -->
    <profile>
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>start-app-for-it</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>start</goal>
                </goals>
                <configuration>
                  <mainClass>${it.app.mainClass}</mainClass>
                  <useTestClasspath>true</useTestClasspath>
                  <maxAttempts>240</maxAttempts>
                  <wait>500</wait>
                  <systemPropertyVariables>
                    <server.port>${it.app.port}</server.port>
                    <spring.datasource.url>${it.datasource.url}</spring.datasource.url>
                    <spring.datasource.driver-class-name>${it.datasource.driver}</spring.datasource.driver-class-name>
                    <spring.datasource.username>${it.datasource.username}</spring.datasource.username>
                    <spring.datasource.password>${it.datasource.password}</spring.datasource.password>
                  </systemPropertyVariables>
                </configuration>
              </execution>
              <execution>
                <id>stop-app-after-it</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>stop</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-maven-plugin</artifactId>
            <version>${springdoc-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>openapi-json</id>
                <phase>integration-test</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <apiDocsUrl>http://localhost:${it.app.port}/v3/api-docs</apiDocsUrl>
                  <outputDir>${project.build.directory}</outputDir>
                  <outputFileName>openapi.json</outputFileName>
                </configuration>
              </execution>
              <execution>
                <id>openapi-yaml</id>
                <phase>integration-test</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <apiDocsUrl>http://localhost:${it.app.port}/v3/api-docs.yaml</apiDocsUrl>
                  <outputDir>${project.build.directory}</outputDir>
                  <outputFileName>openapi.yaml</outputFileName>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
